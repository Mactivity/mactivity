        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 %1$@ 충전기는 바쁠 때 이 Mac이 쓰는 %2$@보다 작아서 그때는 천천히 충전됩니다"
          }
        },
        "nl" : {
          "stringUnit" : {
