    "Your Mac stays closed on the desk, driving its displays, and hardly ever runs on battery." : {
      "comment" : "Next Mac: why a desktop, before the desktop's own reason",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mac bleibt zugeklappt auf dem Schreibtisch, steuert seine Displays an und läuft fast nie mit Batterie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac se queda cerrado en la mesa, usando sus pantallas, y casi nunca funciona con batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
