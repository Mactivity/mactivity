    "%lld external displays: more than a Mac mini drives. A Mac Studio does." : {
      "comment" : "Next Mac: why a Mac Studio, e.g. 4 external displays",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld externe Displays: mehr, als ein Mac mini ansteuern kann. Ein Mac Studio schafft das."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld pantallas externas: más de las que admite un Mac mini. Un Mac Studio sí puede."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld écrans externes : plus que ce qu’un Mac mini peut gérer. Un Mac Studio, oui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld monitor esterni: più di quanti ne gestisca un Mac mini. Un Mac Studio ci riesce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外部ディスプレイ%lld台：Mac miniで使える台数を超えています。Mac Studioなら使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "외장 디스플레이 %lld대: Mac mini가 지원하는 수보다 많습니다. Mac Studio는 지원합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld externe beeldschermen: meer dan een Mac mini aankan. Een Mac Studio kan het wel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld telas externas: mais do que um Mac mini suporta. Um Mac Studio suporta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 台外接显示器：超出 Mac mini 的支持范围。Mac Studio 则可以支持。"
          }
