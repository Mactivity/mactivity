        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "교체를 계획하십시오. 그때까지 백업을 최신 상태로 유지하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan om hem te vervangen; houd tot die tijd je reservekopieën actueel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planeje substituí-la; até lá, mantenha seus backups em dia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请计划更换；在此之前，请保持备份为最新。"
