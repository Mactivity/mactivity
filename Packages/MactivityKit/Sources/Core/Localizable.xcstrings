      }
    },
    "This %@ charger is smaller than this Mac's %@ when busy, so it charges slowly then" : {
      "comment" : "Charger check: the Mac's busiest draw this week is more than the charger gives",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses %1$@-Netzteil ist kleiner als die %2$@, die dieser Mac unter Last braucht, daher lädt er dann langsam"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This %1$@ charger is smaller than this Mac's %2$@ when busy, so it charges slowly then"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este cargador de %1$@ es menor que los %2$@ de este Mac a plena carga, así que entonces carga despacio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
