        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 시간 중 %1$@ 동안 배터리를 사용했습니다. 지금 사용 패턴이라면 완전히 충전했을 때 약 %2$@ 동안 쓸 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ van de tijd op de batterij; een volle lading gaat bij jouw gebruik ongeveer %2$@ mee."
