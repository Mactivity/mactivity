    "If it isn't doing something you asked for, quitting it frees them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die App gerade nichts für dich erledigt, werden die Kerne durch Beenden frei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no está haciendo algo que le hayas pedido, salir de la app los libera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’app ne fait rien que vous ayez demandé, la quitter libère ces cœurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se non sta facendo qualcosa che hai chiesto, chiuderla li libera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頼んだ処理をしていないなら、終了するとコアが解放されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청한 작업을 하고 있지 않다면 종료하여 코어를 확보할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doet het niets waar je om hebt gevraagd, dan komen ze vrij als je het stopt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ele não estiver fazendo algo que você pediu, encerrá-lo libera os núcleos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果它没有在执行你要求的任务，退出它即可释放这些核心。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果它並未在執行你要求的工作，將其結束即可釋放這些核心。"
          }
        }
      }
    },
    "If it travels too, a %@ does the same work." : {
      "comment" : "Next Mac: the laptop worth weighing beside the desktop, e.g. If it travels too, a MacBook Air does the same work.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn er auch mitreist, leistet ein %@ dasselbe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si también viaja, un %@ hace el mismo trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’il voyage aussi, un %@ fait le même travail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lo porti anche in viaggio, un %@ fa lo stesso lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持ち運びもするなら、%@でも同じ作業ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "들고 다니기도 한다면 %@도 같은 작업을 해낼 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaat hij ook mee op reis, dan doet een %@ hetzelfde werk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ele também viaja, um %@ faz o mesmo trabalho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果也要随身携带，%@ 也能胜任同样的工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果也要隨身攜帶，%@ 也能勝任同樣的工作。"
          }
        }
      }
    },
    "In use" : {
