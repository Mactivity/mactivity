        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우, 디스플레이, 애니메이션이 많으면 계속 작업하게 됩니다. 일부를 닫으면 도움이 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
