        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오래 지속되는 무거운 작업이 없습니다. MacBook Air로 팬 없이 조용하게 모두 처리할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen lange zware belasting: een MacBook Air doet dit allemaal, geruisloos en zonder ventilator."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem cargas pesadas longas: um MacBook Air faz tudo isso, em silêncio e sem ventoinha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
