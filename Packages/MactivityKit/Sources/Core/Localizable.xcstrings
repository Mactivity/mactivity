    "On battery %@ of the time; a full charge lasts about %@ at your pace." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ der Zeit im Batteriebetrieb; eine volle Ladung hält bei deiner Nutzung etwa %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On battery %1$@ of the time; a full charge lasts about %2$@ at your pace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con batería el %1$@ del tiempo; una carga completa dura unas %2$@ a tu ritmo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur batterie %1$@ du temps ; une charge complète dure environ %2$@ à votre rythme."
