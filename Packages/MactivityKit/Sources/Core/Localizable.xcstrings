    "The oldest is from %@. Storage → Clean Up shows them; check you don't need one first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das älteste ist vom %@. Unter „Speicherplatz“ → „Aufräumen“ siehst du sie; prüfe vorher, dass du keins mehr brauchst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La más antigua es de %@. Almacenamiento → Limpiar las muestra; comprueba antes que no necesitas ninguna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plus ancienne date de %@. Stockage → Nettoyer les affiche ; vérifiez d’abord que vous n’en avez plus besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il più vecchio è di %@. Archiviazione → Pulisci li mostra; prima controlla di non averne bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最も古いものは%@です。「ストレージ」→「クリーンアップ」で確認できます。必要なものがないか先に確かめてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 오래된 것은 %@입니다. 저장 공간 → 정리에서 볼 수 있습니다. 필요한 것이 없는지 먼저 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De oudste is van %@. Opslag → Opruimen toont ze; controleer eerst of je er geen meer nodig hebt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mais antigo é de %@. Armazenamento → Limpar mostra os backups; confira antes se não precisa de nenhum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最早的备份来自 %@。“储存空间”→“清理”中可以查看；请先确认你不再需要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
