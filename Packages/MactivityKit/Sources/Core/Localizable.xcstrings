        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A batteria per il %1$@ del tempo; una carica completa dura circa %2$@ al tuo ritmo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間の%1$@がバッテリー駆動です。今の使い方なら、フル充電で約%2$@持ちます。"
