    "Files are uploading or downloading. It slows down once they're done." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien werden hoch- oder heruntergeladen. Danach wird es wieder ruhiger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se están subiendo o descargando archivos. La actividad baja cuando terminan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des fichiers sont en cours d’envoi ou de téléchargement. L’activité diminue une fois qu’ils sont terminés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È in corso il caricamento o il download di file. L'attività cala quando finiscono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルのアップロードまたはダウンロード中です。完了すると落ち着きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일을 업로드하거나 다운로드하는 중입니다. 완료되면 느려지지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er worden bestanden geüpload of gedownload. Het wordt rustiger zodra dat klaar is."
