          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eles apontam para apps ou arquivos que não existem mais. Inicialização os mostra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它们指向已不存在的 App 或文件。“启动项”会显示它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它們指向已不存在的 App 或檔案。「啟動項目」會顯示它們。"
          }
        }
      }
    },
    "This %@ charger covers the %@ this Mac is drawing" : {
      "comment" : "Charger check: the charger gives more than the Mac draws now",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses %1$@-Netzteil deckt die %2$@, die dieser Mac gerade braucht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This %1$@ charger covers the %2$@ this Mac is drawing"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este cargador de %1$@ cubre los %2$@ que consume este Mac"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce chargeur de %1$@ couvre les %2$@ que ce Mac consomme"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo alimentatore da %1$@ copre i %2$@ che questo Mac sta usando"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この%1$@の充電器で、このMacが使っている%2$@をまかなえています"
