    "Plan to replace it; until then, keep backups current." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plane einen Austausch ein und halte bis dahin deine Backups aktuell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planea sustituirla; mientras tanto, mantén al día las copias de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévoyez de le remplacer ; d’ici là, gardez vos sauvegardes à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pianifica di sostituirla; nel frattempo, tieni aggiornati i backup."
