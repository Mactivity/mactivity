    "Many windows, displays, or animations keep it working. Closing some helps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viele Fenster, Bildschirme oder Animationen halten ihn beschäftigt. Es hilft, einige zu schließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muchas ventanas, pantallas o animaciones lo mantienen ocupado. Cerrar algunas ayuda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De nombreuses fenêtres, écrans ou animations le sollicitent. En fermer quelques-uns aide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molte finestre, schermi o animazioni lo tengono impegnato. Chiuderne alcune aiuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多数のウインドウ、ディスプレイ、アニメーションが負荷になっています。いくつか閉じると改善します。"
          }
