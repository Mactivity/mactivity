    "On a %@ charger but not charging at %@: macOS is holding the battery there, usually to protect it" : {
      "comment" : "Charger check: plugged in, held short of full by Optimized Battery Charging or a charge limit",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An einem %1$@-Netzteil, aber bei %2$@ wird nicht geladen: macOS hält die Batterie dort, meist um sie zu schonen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On a %1$@ charger but not charging at %2$@: macOS is holding the battery there, usually to protect it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un cargador de %1$@ pero sin cargar al %2$@: macOS mantiene la batería ahí, normalmente para protegerla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur un chargeur de %1$@ mais pas en charge à %2$@ : macOS maintient la batterie à ce niveau, en général pour la préserver"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su un alimentatore da %1$@ ma non in carica al %2$@: macOS tiene la batteria a quel livello, di solito per proteggerla"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@の充電器に接続中ですが、%2$@で充電していません：macOSがバッテリーを保護するため、この残量に保っていることがほとんどです"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 충전기에 연결되었지만 %2$@에서 충전하지 않습니다: macOS가 배터리를 보호하려고 이 수준에 유지하는 경우가 대부분입니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aan een lader van %1$@ maar laadt niet op bij %2$@: macOS houdt de batterij daar, meestal om hem te sparen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em um carregador de %1$@, mas sem carregar em %2$@: o macOS mantém a bateria nesse nível, geralmente para protegê-la"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已接 %1$@ 充电器，但在 %2$@ 时未充电：macOS 让电池停在这里，通常是为了保护电池"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
