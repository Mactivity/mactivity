    "Together they hold %@ of memory. Quitting frees it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusammen belegen sie %@ Speicher. Beenden gibt ihn frei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juntas ocupan %@ de memoria. Salir de ellas la libera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensemble, elles occupent %@ de mémoire. Les quitter la libère."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insieme occupano %@ di memoria. Chiuderle la libera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合計で%@のメモリを使用しています。終了すると解放されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "합쳐서 메모리 %@을(를) 차지하고 있습니다. 종료하면 확보됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samen houden ze %@ aan geheugen vast. Door ze te stoppen komt het vrij."
