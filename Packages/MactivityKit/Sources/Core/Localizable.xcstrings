    "About %@ an hour, more than resting should take. History → Sleep shows what woke it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa %@ pro Stunde, mehr als Ruhe kosten sollte. Verlauf → Ruhezustand zeigt, was ihn geweckt hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alrededor de %@ por hora, más de lo que debería gastar en reposo. Historial → Reposo muestra qué lo despertó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ %@ par heure, plus que ne devrait coûter la veille. Historique → Veille montre ce qui l’a réveillé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circa %@ all’ora, più di quanto dovrebbe consumare a riposo. Cronologia → Stop mostra cosa l’ha risvegliato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1時間あたり約%@で、休止中にしては多すぎます。履歴 → スリープで何が起こしたかを確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시간당 약 %@로, 쉬는 동안 쓰기에는 많습니다. 기록 → 잠자기에서 무엇이 깨웠는지 볼 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongeveer %@ per uur, meer dan rust zou moeten kosten. Geschiedenis → Sluimerstand toont wat hem wekte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca de %@ por hora, mais do que o repouso deveria gastar. Histórico → Repouso mostra o que o acordou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "约每小时 %@，超过了休眠应有的消耗。“历史记录” → “睡眠”显示是什么唤醒了它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "約每小時 %@，超過了休眠應有的消耗。「歷史記錄」→「睡眠」顯示是什麼喚醒了它。"
          }
        }
      }
    },
    "About %@ on a busy day, up to %@, and macOS moved %@ to the disk. More memory keeps it fast." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An einem arbeitsreichen Tag etwa %1$@, bis zu %2$@, und macOS hat %3$@ auf die Festplatte ausgelagert. Mehr Speicher hält den Mac schnell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "About %1$@ on a busy day, up to %2$@, and macOS moved %3$@ to the disk. More memory keeps it fast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos %1$@ en un día de mucho uso, hasta %2$@, y macOS movió %3$@ al disco. Con más memoria, el Mac sigue siendo rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ %1$@ un jour chargé, jusqu’à %2$@, et macOS a déplacé %3$@ sur le disque. Avec plus de mémoire, le Mac reste rapide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circa %1$@ in una giornata intensa, fino a %2$@, e macOS ha spostato %3$@ sul disco. Con più memoria il Mac resta veloce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忙しい日は約%1$@、最大%2$@を使用し、macOSは%3$@をディスクに移動しました。メモリを増やすと速さを保てます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바쁜 날 약 %1$@, 최대 %2$@ 사용. macOS가 %3$@을(를) 디스크로 옮겼습니다. 메모리가 더 많으면 속도를 유지할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongeveer %1$@ op een drukke dag, tot %2$@, en macOS zette %3$@ op de schijf. Met meer geheugen blijft de Mac snel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca de %1$@ num dia movimentado, até %2$@, e o macOS moveu %3$@ para o disco. Com mais memória, o Mac continua rápido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忙碌的一天约 %1$@，最高 %2$@，macOS 还将 %3$@ 移到了磁盘上。更多内存能让 Mac 保持流畅。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忙碌的一天約 %1$@，最高 %2$@，macOS 還將 %3$@ 移到了磁碟上。更多記憶體能讓 Mac 保持流暢。"
          }
        }
      }
    },
