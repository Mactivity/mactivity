    "Near full about %@ a week. A Max chip's extra performance cores finish that work sooner." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa %@ pro Woche fast voll ausgelastet. Die zusätzlichen Leistungskerne eines Max-Chips erledigen das schneller."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casi al máximo unas %@ a la semana. Los núcleos de rendimiento adicionales de un chip Max terminan ese trabajo antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presque à fond environ %@ par semaine. Les cœurs de performance supplémentaires d’une puce Max terminent ce travail plus vite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quasi al massimo circa %@ a settimana. I core ad alte prestazioni in più di un chip Max finiscono quel lavoro prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週に約%@、ほぼフル稼働。Maxチップの追加の高性能コアなら、その作業をより早く終えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주당 약 %@ 동안 거의 최대로 사용합니다. Max 칩의 추가 성능 코어가 그 작업을 더 빨리 끝냅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bijna vol ongeveer %@ per week. De extra prestatiecores van een Max-chip maken dat werk sneller af."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quase no máximo cerca de %@ por semana. Os núcleos de desempenho extras de um chip Max terminam esse trabalho mais rápido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
