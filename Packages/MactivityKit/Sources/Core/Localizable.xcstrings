    },
    "They point to apps or files that are gone. Startup shows them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie verweisen auf Apps oder Dateien, die nicht mehr vorhanden sind. „Systemstart“ zeigt sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apuntan a apps o archivos que ya no existen. Arranque los muestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils pointent vers des apps ou des fichiers qui n’existent plus. Démarrage les affiche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puntano ad app o file che non esistono più. Avvio li mostra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらは存在しなくなったアプリやファイルを指しています。“起動項目”で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 이상 존재하지 않는 앱이나 파일을 가리킵니다. 시동 항목에서 확인할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
