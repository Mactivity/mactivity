    "No long heavy loads: a MacBook Air does all of this, silently and without a fan." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine langen, schweren Lasten: Ein MacBook Air schafft das alles – lautlos und ohne Lüfter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cargas pesadas largas: un MacBook Air hace todo esto, en silencio y sin ventilador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune longue charge lourde : un MacBook Air fait tout cela, en silence et sans ventilateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun carico pesante prolungato: un MacBook Air fa tutto questo, in silenzio e senza ventola."
