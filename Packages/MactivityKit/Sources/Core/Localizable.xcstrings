    "Give it air, and close what you don't need until it cools." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorg für Luftzufuhr und schließe, was du nicht brauchst, bis er abgekühlt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que le llegue aire y cierra lo que no necesites hasta que se enfríe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dégagez ses aérations et fermez ce dont vous n’avez pas besoin le temps qu’il refroidisse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascialo respirare e chiudi ciò che non ti serve finché non si raffredda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通気を確保し、冷えるまで不要なものを閉じてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통풍이 잘되게 하고, 식을 때까지 필요 없는 항목을 닫으십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef hem lucht en sluit wat je niet nodig hebt tot hij is afgekoeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o ar circular e feche o que não precisa até ele esfriar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请保持通风，并在降温前关闭不需要的项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請保持通風，並在降溫前關閉不需要的項目。"
          }
        }
      }
    },
