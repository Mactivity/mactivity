        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há arquivos sendo enviados ou baixados. A atividade diminui quando terminarem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在上传或下载文件。完成后活动就会减少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在上傳或下載檔案。完成後活動就會減少。"
          }
        }
      }
    },
    "For %@ today. The CPU tab shows which apps were busiest." : {
