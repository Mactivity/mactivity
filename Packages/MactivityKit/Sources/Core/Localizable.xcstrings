    "Automatic backups are on, but none has finished since %@. Connect the backup disk, or open Time Machine settings to see why." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatische Backups sind an, aber seit %@ wurde keines fertig. Schließe das Backup-Volume an oder öffne die Time Machine-Einstellungen, um zu sehen, warum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias automáticas están activadas, pero ninguna ha terminado desde el %@. Conecta el disco de copia o abre los ajustes de Time Machine para ver por qué."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes automatiques sont activées, mais aucune n’a abouti depuis le %@. Branchez le disque de sauvegarde ou ouvrez les réglages de Time Machine pour savoir pourquoi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I backup automatici sono attivi, ma nessuno è terminato dal %@. Collega il disco di backup o apri le impostazioni di Time Machine per capire perché."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動バックアップはオンですが、%@以降完了したバックアップがありません。バックアップディスクを接続するか、Time Machine設定を開いて原因を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 백업이 켜져 있지만 %@ 이후 완료된 백업이 없습니다. 백업 디스크를 연결하거나 Time Machine 설정을 열어 이유를 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatische reservekopieën staan aan, maar sinds %@ is er geen klaar. Sluit de reservekopieschijf aan of open de Time Machine-instellingen om te zien waarom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os backups automáticos estão ativados, mas nenhum terminou desde %@. Conecte o disco de backup ou abra os ajustes do Time Machine para ver o motivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动备份已开启，但自 %@ 以来没有完成过备份。请连接备份磁盘，或打开“时间机器”设置查看原因。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動備份已開啟，但自 %@ 以來沒有完成過備份。請連接備份磁碟，或打開「時光機」設定查看原因。"
          }
        }
      }
    },
