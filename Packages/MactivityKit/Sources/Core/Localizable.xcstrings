          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps se abren sin que macOS compruebe quién las ha creado ni si son malware conocido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
