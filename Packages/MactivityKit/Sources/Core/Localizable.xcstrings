    "The drive has switched itself to read-only to protect your data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Laufwerk hat in den schreibgeschützten Modus gewechselt, um deine Daten zu schützen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La unidad se ha puesto en modo de solo lectura para proteger tus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le disque est passé de lui-même en lecture seule pour protéger vos données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'unità è passata da sola in sola lettura per proteggere i tuoi dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データを保護するため、ドライブが自動的に読み出し専用に切り替わりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터를 보호하기 위해 드라이브가 스스로 읽기 전용으로 전환되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De schijf is uit zichzelf overgeschakeld naar alleen-lezen om je gegevens te beschermen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A unidade passou sozinha para o modo somente leitura para proteger seus dados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为保护你的数据，驱动器已自行切换为只读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為保護你的資料，磁碟已自行切換為唯讀。"
          }
        }
      }
    },
    "The drive is running out of spare space to replace worn blocks." : {
      "localizations" : {
        "de" : {
