  "strings" : {
    " At this pace, %@ by %@." : {
      "comment" : "Data budget alert, after the figures: the projected total and the reset date",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Bei diesem Tempo %1$@ bis %2$@."
          }
