        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : " At this pace, %1$@ by %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " A este ritmo, %1$@ para el %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " À ce rythme, %1$@ d’ici le %2$@."
