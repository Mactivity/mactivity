        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Docker envoie au conteneur son signal d’arrêt et le tue s’il tourne encore après %lld seconde."
                }
