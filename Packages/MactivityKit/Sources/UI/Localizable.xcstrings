    "Notes show on Your day and on History's charts. They stay on this Mac until you delete them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notizen erscheinen unter „Dein Tag“ und in den Diagrammen im Verlauf. Sie bleiben auf diesem Mac, bis du sie löschst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notas aparecen en Tu día y en las gráficas de Historial. Se quedan en este Mac hasta que las elimines."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notes apparaissent dans Votre journée et sur les graphiques d’Historique. Elles restent sur ce Mac jusqu’à ce que vous les supprimiez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le note appaiono in La tua giornata e nei grafici di Cronologia. Restano su questo Mac finché non le elimini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモは「1日の流れ」と履歴のグラフに表示されます。削除するまでこのMacに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모는 하루 돌아보기와 기록 차트에 표시됩니다. 삭제하기 전까지 이 Mac에 보관됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notities verschijnen in Je dag en in de grafieken van Geschiedenis. Ze blijven op deze Mac tot je ze verwijdert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notas aparecem em Seu dia e nos gráficos do Histórico. Elas ficam neste Mac até você apagá-las."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备注会显示在“你的一天”和历史记录的图表上。它们会一直保存在这台 Mac 上，直到你删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
