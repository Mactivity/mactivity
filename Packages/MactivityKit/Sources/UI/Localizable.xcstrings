    "Too little matching charging to compare the %@ and %@ chargers yet: %@ of the hour it takes." : {
      "comment" : "Chargers compared: two ratings, how much charging there is so far",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch zu wenig vergleichbares Laden, um die Netzteile mit %1$@ und %2$@ zu vergleichen: %3$@ der nötigen Stunde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Too little matching charging to compare the %1$@ and %2$@ chargers yet: %3$@ of the hour it takes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún hay muy poca carga comparable para comparar los cargadores de %1$@ y %2$@: %3$@ de la hora necesaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore assez de charge comparable pour comparer les chargeurs de %1$@ et %2$@ : %3$@ sur l’heure nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora troppo poca ricarica corrispondente per confrontare gli alimentatori da %1$@ e %2$@: %3$@ dell'ora necessaria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条件が一致した充電が少なく、%1$@と%2$@の充電器をまだ比較できません：必要な1時間のうち%3$@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조건이 일치한 충전이 부족해 %1$@ 충전기와 %2$@ 충전기를 아직 비교할 수 없습니다: 필요한 1시간 중 %3$@."
