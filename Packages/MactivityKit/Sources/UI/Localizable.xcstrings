    "Detail by the minute for 48 hours, by the quarter-hour for 30 days, then by the hour. A year takes about 25 to 50 MB." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minutengenau für 48 Stunden, im Viertelstundentakt für 30 Tage, danach stündlich. Ein Jahr belegt etwa 25 bis 50 MB."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detalle por minuto durante 48 horas, por cuarto de hora durante 30 días y después por hora. Un año ocupa entre 25 y 50 MB aproximadamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détail à la minute pendant 48 heures, au quart d’heure pendant 30 jours, puis à l’heure. Une année occupe environ 25 à 50 Mo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dettaglio al minuto per 48 ore, al quarto d’ora per 30 giorni, poi all’ora. Un anno occupa circa 25-50 MB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "48時間は1分ごと、30日間は15分ごと、それ以降は1時間ごとに記録します。1年分で約25〜50 MBです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "48시간 동안은 1분 단위, 30일 동안은 15분 단위, 그 이후는 1시간 단위로 기록합니다. 1년 분량은 약 25~50MB입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per minuut gedurende 48 uur, per kwartier gedurende 30 dagen, daarna per uur. Een jaar neemt ongeveer 25 tot 50 MB in beslag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detalhe por minuto durante 48 horas, por quarto de hora durante 30 dias e depois por hora. Um ano ocupa cerca de 25 a 50 MB."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "48 小时内按分钟记录，30 天内按 15 分钟记录，之后按小时记录。一年约占用 25 至 50 MB。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "48 小時內按分鐘記錄，30 天內按 15 分鐘記錄，之後按小時記錄。一年約佔用 25 至 50 MB。"
          }
        }
      }
    },
