    "Adds a Sound tab with a slider per app. Needs permission to listen to app audio; nothing is recorded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt einen Tab „Ton“ mit einem Regler pro App hinzu. Erfordert die Erlaubnis, auf den Ton von Apps zuzugreifen; es wird nichts aufgenommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una pestaña Sonido con un regulador por app. Requiere permiso para escuchar el audio de las apps; no se graba nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un onglet Son avec un curseur par app. Nécessite l’autorisation d’écouter l’audio des apps ; rien n’est enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge una scheda Suono con un cursore per ogni app. Richiede l'autorizzazione ad ascoltare l'audio delle app; non viene registrato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリごとのスライダがある“サウンド”タブを追加します。アプリのオーディオを取得するためのアクセス許可が必要です。録音は一切行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱별 슬라이더가 있는 사운드 탭을 추가합니다. 앱 오디오를 수신하려면 권한이 필요하며, 녹음되는 내용은 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt een tabblad Geluid toe met een schuifknop per app. Vereist toestemming om naar app-audio te luisteren; er wordt niets opgenomen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona uma aba Som com um controle deslizante por app. Precisa de permissão para ouvir o áudio dos apps; nada é gravado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加“声音”标签页，为每个 App 提供一个滑块。需要监听 App 音频的权限；不会录制任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入「聲音」標籤頁，為每個 App 提供一個滑桿。需要監聽 App 音訊的權限；不會錄製任何內容。"
          }
        }
      }
    },
