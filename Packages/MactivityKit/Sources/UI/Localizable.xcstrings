    "This Mac talking to itself. Apps use it to reach servers running on the same Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac spricht mit sich selbst. Apps nutzen das, um Server zu erreichen, die auf demselben Mac laufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac hablando consigo mismo. Las apps lo usan para llegar a servidores que se ejecutan en el mismo Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac qui communique avec lui-même. Les apps s’en servent pour joindre des serveurs exécutés sur le même Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Mac che parla con sé stesso. Le app lo usano per raggiungere server in esecuzione sullo stesso Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacが自分自身と通信するための接続です。アプリは、同じMac上で動作するサーバにつなぐときに使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac이 자기 자신과 통신하는 연결입니다. 앱이 같은 Mac에서 실행 중인 서버에 접속할 때 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze Mac die met zichzelf praat. Apps gebruiken dit om servers te bereiken die op dezelfde Mac draaien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac conversando consigo mesmo. Os apps o usam para acessar servidores em execução no mesmo Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 与自己通信。App 用它来连接同一台 Mac 上运行的服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這部 Mac 與自己通訊。App 用它來連接同一部 Mac 上執行的伺服器。"
          }
        }
      }
    },
