    "It ran down under 10%% %lld times in 4 weeks. Plugging in a little sooner is easier on the battery." : {
      "comment" : "Charging habits: how many times the battery dropped under 10%",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Sie fiel in 4 Wochen %lld-mal unter 10 %%. Etwas früher anzuschließen schont die Batterie."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Sie fiel in 4 Wochen %lld-mal unter 10 %%. Etwas früher anzuschließen schont die Batterie."
                }
