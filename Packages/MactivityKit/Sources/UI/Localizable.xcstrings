          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity a besoin de l’accès complet au disque pour lire les extensions de %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity ha bisogno dell’accesso completo al disco per leggere le estensioni di %@."
          }
        },
