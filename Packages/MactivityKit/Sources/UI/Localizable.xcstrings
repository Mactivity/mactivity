    "Like for like, the %@ and %@ chargers fill the battery about as fast, over %@ of matching charging." : {
      "comment" : "Chargers compared: two ratings, how much charging it's based on",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter gleichen Bedingungen laden die Netzteile mit %1$@ und %2$@ die Batterie etwa gleich schnell, gemessen über %3$@ vergleichbares Laden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Like for like, the %1$@ and %2$@ chargers fill the battery about as fast, over %3$@ of matching charging."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En igualdad de condiciones, los cargadores de %1$@ y %2$@ llenan la batería casi igual de rápido, sobre %3$@ de carga comparable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À conditions égales, les chargeurs de %1$@ et %2$@ remplissent la batterie à peu près aussi vite, sur %3$@ de charge comparable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A parità di condizioni, gli alimentatori da %1$@ e %2$@ ricaricano la batteria a velocità simile, su %3$@ di ricarica corrispondente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ条件では、%1$@と%2$@の充電器の充電速度はほぼ同じです（条件が一致した充電%3$@に基づく）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 조건에서 %1$@ 충전기와 %2$@ 충전기의 충전 속도는 비슷합니다(조건이 일치한 충전 %3$@ 기준)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onder gelijke omstandigheden laden de laders van %1$@ en %2$@ de batterij ongeveer even snel, gemeten over %3$@ vergelijkbaar opladen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em condições iguais, os carregadores de %1$@ e %2$@ enchem a bateria em velocidade parecida, em %3$@ de recarga equivalente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在同等条件下，根据 %3$@ 条件相符的充电，%1$@ 和 %2$@ 充电器的充电速度大致相同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在同等條件下，根據 %3$@ 條件相符的充電，%1$@ 和 %2$@ 充電器的充電速度大致相同。"
          }
        }
      }
    },
    "Like for like, the %@ charger filled the battery %@ faster than the %@ one, over %@ of matching charging." : {
      "comment" : "Chargers compared: the faster rating, how much faster, the slower rating, how much charging it's based on",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter gleichen Bedingungen lud das Netzteil mit %1$@ die Batterie %2$@ schneller als das mit %3$@, gemessen über %4$@ vergleichbares Laden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Like for like, the %1$@ charger filled the battery %2$@ faster than the %3$@ one, over %4$@ of matching charging."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En igualdad de condiciones, el cargador de %1$@ llenó la batería un %2$@ más rápido que el de %3$@, sobre %4$@ de carga comparable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À conditions égales, le chargeur de %1$@ a rempli la batterie %2$@ plus vite que celui de %3$@, sur %4$@ de charge comparable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A parità di condizioni, l'alimentatore da %1$@ ha ricaricato la batteria il %2$@ più velocemente di quello da %3$@, su %4$@ di ricarica corrispondente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ条件では、%1$@の充電器は%3$@の充電器より%2$@速く充電しました（条件が一致した充電%4$@に基づく）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 조건에서 %1$@ 충전기가 %3$@ 충전기보다 %2$@ 빠르게 충전했습니다(조건이 일치한 충전 %4$@ 기준)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onder gelijke omstandigheden laadde de lader van %1$@ de batterij %2$@ sneller dan die van %3$@, gemeten over %4$@ vergelijkbaar opladen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em condições iguais, o carregador de %1$@ encheu a bateria %2$@ mais rápido que o de %3$@, em %4$@ de recarga equivalente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在同等条件下，根据 %4$@ 条件相符的充电，%1$@ 充电器比 %3$@ 充电器快 %2$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在同等條件下，根據 %4$@ 條件相符的充電，%1$@ 充電器比 %3$@ 充電器快 %2$@。"
          }
        }
      }
    },
