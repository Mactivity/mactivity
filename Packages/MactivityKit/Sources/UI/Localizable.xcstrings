        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mactivity precisa de Acesso Total ao Disco para ler as extensões do %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
