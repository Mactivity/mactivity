    "A process that listens on a TCP port from inside a project folder shows up here." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prozesse, die aus einem Projektordner heraus einen TCP-Port abhören, werden hier angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparece cualquier proceso que escuche en un puerto TCP desde una carpeta de proyecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout processus qui écoute sur un port TCP depuis un dossier de projet apparaît ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui compare ogni processo in ascolto su una porta TCP dall'interno di una cartella di progetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトフォルダ内からTCPポートで待機しているプロセスがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트 폴더 내에서 TCP 포트를 수신 대기하는 프로세스가 여기에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een proces dat vanuit een projectmap op een TCP-poort luistert, verschijnt hier."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um processo que escuta em uma porta TCP de dentro de uma pasta de projeto aparece aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在项目文件夹中监听 TCP 端口的进程会显示在这里。"
