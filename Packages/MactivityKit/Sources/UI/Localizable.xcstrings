    "Channel %@ sounds quieter from here. The channel is a setting on your router; Mactivity doesn't change anything." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanal %@ wirkt von hier aus ruhiger. Der Kanal ist eine Einstellung an deinem Router; Mactivity ändert nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El canal %@ parece más tranquilo desde aquí. El canal es un ajuste de tu router; Mactivity no cambia nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le canal %@ semble plus calme d’ici. Le canal est un réglage de votre routeur ; Mactivity ne modifie rien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da qui il canale %@ sembra meno affollato. Il canale è un'impostazione del router; Mactivity non modifica nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacからはチャンネル%@のほうが空いているようです。チャンネルはルーターの設定で、Mactivityは何も変更しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서는 채널 %@이(가) 더 한산한 것으로 보입니다. 채널은 라우터 설정이며, Mactivity는 아무것도 변경하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanaal %@ lijkt van hieruit rustiger. Het kanaal is een instelling op je router; Mactivity wijzigt niets."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daqui, o canal %@ parece menos congestionado. O canal é um ajuste do roteador; o Mactivity não altera nada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从这里看，信道 %@ 似乎较空闲。信道是路由器上的设置；Mactivity 不会更改任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從這裡看，頻道 %@ 似乎較空閒。頻道是路由器上的設定；Mactivity 不會更改任何內容。"
          }
        }
      }
    },
