        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligenceは現在回答できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence가 지금은 답변할 수 없습니다. 잠시 후 다시 시도하십시오."
          }
        },
        "nl" : {
