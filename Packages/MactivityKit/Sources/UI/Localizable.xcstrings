    "Mactivity always lives in the menu bar. Turn the window off to start quietly at login." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity ist immer in der Menüleiste. Schalte das Fenster aus, um bei der Anmeldung unauffällig zu starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity siempre está en la barra de menús. Desactiva la ventana para que se inicie discretamente al iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity est toujours dans la barre des menus. Désactivez la fenêtre pour démarrer discrètement à l’ouverture de session."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity è sempre nella barra dei menu. Disattiva la finestra per avviarlo in modo discreto al login."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivityは常にメニューバーに常駐します。ウインドウをオフにすると、ログイン時に目立たずに起動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity는 항상 메뉴 막대에 상주합니다. 윈도우를 끄면 로그인 시 조용히 시작됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity staat altijd in de menubalk. Zet het venster uit om bij het inloggen stil te starten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mactivity está sempre na barra de menus. Desative a janela para iniciar discretamente ao iniciar sessão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity 始终驻留在菜单栏中。关闭窗口选项即可在登录时安静启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity 一律常駐在選單列中。關閉視窗選項即可在登入時安靜啟動。"
          }
        }
      }
    },
    "Mactivity can show your Bluetooth accessories' batteries. macOS asks for Bluetooth access first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity kann die Batterien deiner Bluetooth-Geräte anzeigen. macOS fragt zuerst nach dem Bluetooth-Zugriff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity puede mostrar las baterías de tus accesorios Bluetooth. macOS pide primero acceso a Bluetooth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity peut afficher la batterie de vos accessoires Bluetooth. macOS demande d’abord l’accès au Bluetooth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity può mostrare le batterie degli accessori Bluetooth. macOS chiede prima l'accesso al Bluetooth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MactivityではBluetoothアクセサリのバッテリーを表示できます。最初にmacOSからBluetoothへのアクセスが求められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity는 Bluetooth 액세서리의 배터리를 표시할 수 있습니다. 먼저 macOS가 Bluetooth 접근 권한을 요청합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity kan de batterijen van je Bluetooth-accessoires tonen. macOS vraagt eerst om Bluetooth-toegang."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mactivity pode mostrar as baterias dos seus acessórios Bluetooth. O macOS pede acesso ao Bluetooth antes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity 可以显示蓝牙配件的电池电量。macOS 会先请求蓝牙访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity 可以顯示藍牙配件的電池電量。macOS 會先要求藍牙取用權限。"
          }
        }
      }
    },
    "Mactivity can't read %@. Full Disk Access lets it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity kann %@ nicht lesen. Der Festplattenvollzugriff erlaubt es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity no puede leer %@. El acceso total al disco lo permite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity ne peut pas lire %@. L’accès complet au disque le permet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity non può leggere %@. L’accesso completo al disco lo consente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivityは%@を読み取れません。フルディスクアクセスを許可すると読み取れるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity가 %@을(를) 읽을 수 없습니다. 전체 디스크 접근 권한을 허용하면 읽을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity kan %@ niet lezen. Met volledige schijftoegang kan het dat wel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mactivity não consegue ler %@. O Acesso Total ao Disco permite."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity 无法读取 %@。开启“完全磁盘访问权限”后即可读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity 無法讀取 %@。開啟「完整磁碟取用權限」後即可讀取。"
          }
        }
      }
    },
    "Mactivity can't read %@. Full Disk Access may be off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity kann %@ nicht lesen. Möglicherweise ist der Festplattenvollzugriff aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity no puede leer %@. Puede que el acceso total al disco esté desactivado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity ne peut pas lire %@. L’accès complet au disque est peut-être désactivé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity non può leggere %@. L'accesso completo al disco potrebbe essere disattivato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivityは%@を読み取れません。フルディスクアクセスがオフになっている可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity가 %@을(를) 읽을 수 없습니다. 전체 디스크 접근 권한이 꺼져 있을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity kan %@ niet lezen. Volledige schijftoegang staat mogelijk uit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mactivity não consegue ler %@. O Acesso Total ao Disco pode estar desativado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity 无法读取 %@。“完全磁盘访问权限”可能已关闭。"
          }
        },
        "zh-Hant" : {
