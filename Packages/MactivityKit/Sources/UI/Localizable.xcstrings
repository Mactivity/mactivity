    "Idle cost: about %@ of one core, against %@ for the icon." : {
      "comment" : "Menu bar mode's idle CPU, e.g. 0.18%, against the icon mode's",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leerlaufkosten: etwa %1$@ eines Kerns, gegenüber %2$@ für das Symbol."
          }
        },
        "en" : {
          "stringUnit" : {
