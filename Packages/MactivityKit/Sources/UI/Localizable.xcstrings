    "This Mac is enrolled in device management, so an organization can install profiles and change settings on it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac ist bei einer Geräteverwaltung registriert, also kann eine Organisation Profile darauf installieren und Einstellungen ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac está inscrito en la gestión de dispositivos, así que una organización puede instalar perfiles y cambiar ajustes en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac est inscrit à la gestion de l’appareil : une organisation peut donc y installer des profils et modifier ses réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Mac è registrato nella gestione dispositivi, quindi un'organizzazione può installarvi profili e modificarne le impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacはデバイス管理に登録されているため、組織がプロファイルをインストールしたり設定を変更したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac은 기기 관리에 등록되어 있어 조직에서 프로파일을 설치하고 설정을 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze Mac is ingeschreven bij apparaatbeheer, dus een organisatie kan er profielen op installeren en instellingen wijzigen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac está registrado no gerenciamento de dispositivos, então uma organização pode instalar perfis e alterar ajustes nele."
