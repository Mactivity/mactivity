          }
        }
      }
    },
    "The share didn't answer within 3 seconds. The server may be off or out of reach." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Freigabe hat nicht innerhalb von 3 Sekunden geantwortet. Der Server ist vielleicht aus oder nicht erreichbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El recurso compartido no ha respondido en 3 segundos. Puede que el servidor esté apagado o fuera de alcance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le partage n’a pas répondu sous 3 secondes. Le serveur est peut-être éteint ou hors d’atteinte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La condivisione non ha risposto entro 3 secondi. Il server potrebbe essere spento o irraggiungibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有から3秒以内に応答がありませんでした。サーバがオフか、接続できない可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유가 3초 안에 응답하지 않았습니다. 서버가 꺼져 있거나 연결할 수 없을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De share antwoordde niet binnen 3 seconden. De server staat misschien uit of is niet bereikbaar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O compartilhamento não respondeu em 3 segundos. O servidor pode estar desligado ou fora de alcance."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享未在 3 秒内响应。服务器可能已关闭或无法访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享未在 3 秒內回應。伺服器可能已關閉或無法連線。"
          }
        }
      }
    },
    "The standard the link runs at. Autoselect means it agrees on the best one with the other end." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standard, mit dem die Verbindung arbeitet. Autoselect heißt, dass sie sich mit der Gegenstelle auf den besten einigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El estándar con el que funciona el enlace. Autoselect significa que acuerda el mejor con el otro extremo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La norme utilisée par la liaison. Autoselect signifie qu’elle choisit la meilleure avec l’autre extrémité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo standard su cui funziona il collegamento. Autoselect significa che concorda il migliore con l’altro estremo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この接続が使っている規格です。「autoselect」は、相手側と相談して最適なものを自動で選ぶという意味です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결이 사용하는 표준입니다. Autoselect는 반대편과 협의해 가장 좋은 표준을 고른다는 뜻입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De standaard waarmee de verbinding werkt. Autoselect betekent dat hij met de andere kant de beste afspreekt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O padrão em que o link funciona. Autoselect significa que ele combina o melhor com a outra ponta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此连接所采用的标准。Autoselect 表示与对端协商，自动选择最合适的一种。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此連線所採用的標準。Autoselect 表示與對端協商，自動選擇最合適的一種。"
          }
        }
      }
    },
