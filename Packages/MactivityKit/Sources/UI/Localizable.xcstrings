    "Nothing installed is past its end of life, and Homebrew's packages have no known vulnerabilities." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine installierte Software hat ihr Supportende erreicht, und die Homebrew-Pakete haben keine bekannten Sicherheitslücken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de lo instalado ha llegado al fin de su soporte, y los paquetes de Homebrew no tienen vulnerabilidades conocidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun logiciel installé n’a atteint sa fin de prise en charge, et les paquets Homebrew n’ont aucune vulnérabilité connue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun software installato ha raggiunto la fine del supporto e i pacchetti Homebrew non hanno vulnerabilità note."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サポートが終了したものはインストールされておらず、Homebrewのパッケージに既知の脆弱性はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원이 종료된 설치 항목이 없으며, Homebrew 패키지에 알려진 취약점이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niets wat is geïnstalleerd is voorbij het einde van de ondersteuning, en de pakketten van Homebrew hebben geen bekende kwetsbaarheden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada instalado passou do fim do suporte, e os pacotes do Homebrew não têm vulnerabilidades conhecidas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装的软件均未停止支持，Homebrew 软件包也没有已知漏洞。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安裝的軟體皆未停止支援，Homebrew 套件也沒有已知漏洞。"
          }
        }
      }
    },
    "Nothing installed is past its end of life. To check Homebrew's packages for known vulnerabilities too, turn it on in Settings → Privacy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine installierte Software hat ihr Supportende erreicht. Um Homebrew-Pakete auch auf bekannte Sicherheitslücken zu prüfen, aktiviere dies unter „Einstellungen“ → „Datenschutz“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de lo instalado ha llegado al fin de su soporte. Para buscar también vulnerabilidades conocidas en los paquetes de Homebrew, actívalo en Ajustes → Privacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun logiciel installé n’a atteint sa fin de prise en charge. Pour rechercher aussi les vulnérabilités connues dans les paquets Homebrew, activez l’option dans Réglages → Confidentialité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun software installato ha raggiunto la fine del supporto. Per cercare anche vulnerabilità note nei pacchetti Homebrew, attiva l’opzione in Impostazioni → Privacy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サポートが終了したものはインストールされていません。Homebrewのパッケージの既知の脆弱性も確認するには、「設定」→「プライバシー」でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원이 종료된 설치 항목이 없습니다. Homebrew 패키지의 알려진 취약점도 확인하려면 설정 → 개인정보 보호에서 켜십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niets wat is geïnstalleerd is voorbij het einde van de ondersteuning. Zet de controle aan in Instellingen → Privacy om de pakketten van Homebrew ook op bekende kwetsbaarheden te controleren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada instalado passou do fim do suporte. Para verificar também vulnerabilidades conhecidas nos pacotes do Homebrew, ative a opção em Ajustes → Privacidade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装的软件均未停止支持。如需同时检查 Homebrew 软件包的已知漏洞，请在“设置”→“隐私”中开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安裝的軟體皆未停止支援。若要同時檢查 Homebrew 套件的已知漏洞，請在「設定」→「隱私權」中開啟。"
          }
        }
      }
    },
