    "A Thunderbolt port. It carries a network when it's cabled to another Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Thunderbolt-Anschluss. Er überträgt ein Netzwerk, wenn er per Kabel mit einem anderen Mac verbunden ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un puerto Thunderbolt. Transporta una red cuando está conectado por cable a otro Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un port Thunderbolt. Il transporte un réseau lorsqu’il est relié par câble à un autre Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una porta Thunderbolt. Trasporta una rete quando è collegata con un cavo a un altro Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thunderboltポートです。別のMacとケーブルで接続すると、ネットワークとして使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thunderbolt 포트입니다. 다른 Mac과 케이블로 연결하면 네트워크로 사용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een Thunderbolt-poort. Die werkt als netwerk zodra hij met een kabel op een andere Mac is aangesloten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma porta Thunderbolt. Ela transporta uma rede quando está conectada por cabo a outro Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thunderbolt 接口。用线缆连接另一台 Mac 时，可以传输网络数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thunderbolt 連接埠。用線材連接另一部 Mac 時，可以傳輸網路資料。"
          }
        }
      }
    },
