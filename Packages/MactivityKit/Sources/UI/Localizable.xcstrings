          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover “%1$@” (%2$@) para o Lixo?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要将“%1$@”（%2$@）移到废纸篓吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要將「%1$@」（%2$@）丟到垃圾桶嗎？"
