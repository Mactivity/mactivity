    "Docker sends the container its stop signal and kills it if it's still running after %lld seconds." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Docker sendet dem Container sein Stoppsignal und beendet ihn zwangsweise, falls er nach %lld Sekunde noch läuft."
                }
              },
              "other" : {
                "stringUnit" : {
