    "Wipe away: keys do nothing until you unlock it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einfach abwischen: Tasten bewirken nichts, bis du entsperrst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Límpialo: las teclas no hacen nada hasta que lo desbloquees."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essuyez : les touches ne font rien tant que vous ne déverrouillez pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulisci pure: i tasti non fanno nulla finché non la sblocchi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拭いても大丈夫です。解除するまでキーは反応しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "닦아도 됩니다. 잠금을 해제할 때까지 키가 작동하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg maar: toetsen doen niets tot je ontgrendelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode limpar: as teclas não fazem nada até você desbloquear."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放心擦拭：解锁前按键不起作用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放心擦拭：解鎖前按鍵不起作用。"
          }
        }
      }
    },
    "Wired" : {
      "comment" : "Memory figure: wired memory",
      "localizations" : {
