    "Apple's urgent fixes and malware definitions arrive without waiting for a macOS update." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dringende Korrekturen und Malware-Definitionen von Apple kommen, ohne auf ein macOS-Update zu warten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las correcciones urgentes de Apple y las definiciones de malware llegan sin esperar a una actualización de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les correctifs urgents d’Apple et les définitions de logiciels malveillants arrivent sans attendre une mise à jour de macOS."
