                  "value" : "Docker invia al container il segnale di arresto e lo termina forzatamente se è ancora in esecuzione dopo %lld secondo."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Docker invia al container il segnale di arresto e lo termina forzatamente se è ancora in esecuzione dopo %lld secondi."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
