    },
    "Frees %@. A watcher or test runner stays stopped until you start it again." : {
      "comment" : "Quit dev tools confirmation, with watchers or test runners among them: the memory they hold",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt %@ frei. Ein Watcher oder Testrunner bleibt gestoppt, bis du ihn wieder startest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera %@. Un watcher o ejecutor de pruebas sigue detenido hasta que lo vuelvas a iniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libère %@. Un watcher ou un lanceur de tests reste arrêté jusqu’à ce que vous le relanciez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera %@. Un watcher o un test runner resta fermo finché non lo riavvii."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を解放します。ウォッチャーやテストランナーは、もう一度起動するまで停止したままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 확보합니다. 감시 도구나 테스트 러너는 다시 시작할 때까지 멈춘 상태로 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt %@ vrij. Een watcher of testrunner blijft gestopt tot je hem weer start."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera %@. Um watcher ou executor de testes fica parado até você iniciá-lo de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "释放 %@。监视器或测试运行器会一直停止，直到你再次启动它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "釋放 %@。監看器或測試執行器會一直停止，直到你再次啟動它。"
          }
        }
      }
    },
    "Frees %@. Your editor starts them again when it needs them." : {
      "comment" : "Quit dev tools confirmation: the memory they hold",
      "localizations" : {
        "de" : {
