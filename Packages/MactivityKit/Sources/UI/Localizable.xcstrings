    "Changes only when your Mac is under strain. The lightest option." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert sich nur, wenn dein Mac stark belastet ist. Die sparsamste Option."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo cambia cuando tu Mac está bajo presión. La opción más ligera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne change que lorsque votre Mac est très sollicité. L’option la plus légère."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia solo quando il Mac è sotto sforzo. L'opzione più leggera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macに負荷がかかっているときだけ変化します。最も軽いオプションです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에 부하가 걸릴 때만 변경됩니다. 가장 가벼운 옵션입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verandert alleen als je Mac zwaar belast is. De lichtste optie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muda apenas quando o Mac está sobrecarregado. A opção mais leve."
          }
        },
        "zh-Hans" : {
