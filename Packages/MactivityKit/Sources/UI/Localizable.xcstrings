          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het stopt direct, zonder kans om op te ruimen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele é parado imediatamente, sem chance de fazer a limpeza."
          }
        },
        "zh-Hans" : {
