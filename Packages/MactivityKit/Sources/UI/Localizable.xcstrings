    "Larger makes every figure and chart label bigger, for reading Mactivity from across the desk." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Größer“ vergrößert alle Werte und Diagrammbeschriftungen, damit du Mactivity auch vom anderen Ende des Schreibtischs lesen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Más grande” aumenta todos los valores y etiquetas de gráficos, para leer Mactivity desde el otro lado de la mesa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Plus grande » agrandit toutes les valeurs et étiquettes de graphiques, pour lire Mactivity depuis l’autre bout du bureau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più grandi ingrandisce ogni valore ed etichetta dei grafici, per leggere Mactivity dall'altro lato della scrivania."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“大きめ”にするとすべての数値とグラフのラベルが大きくなり、机の向こうからでもMactivityを読めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘크게’를 선택하면 모든 수치와 차트 레이블이 커져서 책상 건너편에서도 Mactivity를 읽을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Groter’ maakt elke waarde en elk grafieklabel groter, om Mactivity vanaf de andere kant van het bureau te lezen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maiores aumenta cada valor e rótulo de gráfico, para ler o Mactivity do outro lado da mesa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“较大”会放大所有数值和图表标签，方便隔着桌子查看 Mactivity。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「較大」會放大所有數值和圖表標籤，方便隔著桌子查看 Mactivity。"
          }
        }
      }
