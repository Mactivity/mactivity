    "Scan your home folder to map every folder by size, see what's safe to rebuild, and find the largest files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne deinen Benutzerordner, um jeden Ordner nach Größe zu erfassen, zu sehen, was sich gefahrlos neu erstellen lässt, und die größten Dateien zu finden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analiza tu carpeta de inicio para mapear cada carpeta por tamaño, ver qué se puede regenerar sin riesgo y encontrar los archivos más grandes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analysez votre dossier de départ pour cartographier chaque dossier par taille, voir ce qui peut être recréé sans risque et trouver les fichiers les plus volumineux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona la cartella Inizio per mappare ogni cartella in base alle dimensioni, vedere cosa si può ricreare senza rischi e trovare i file più grandi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームフォルダをスキャンすると、すべてのフォルダをサイズ別にマップ表示し、安全に再作成できるものを確認して、最大のファイルを見つけることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 폴더를 스캔하여 모든 폴더를 크기별로 맵에 표시하고, 안전하게 다시 만들 수 있는 항목을 확인하고, 가장 큰 파일을 찾을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan je thuismap om elke map op grootte in kaart te brengen, te zien wat veilig opnieuw op te bouwen is en de grootste bestanden te vinden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analise sua pasta de início para mapear cada pasta por tamanho, ver o que é seguro recriar e encontrar os maiores arquivos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描你的个人文件夹，按大小查看每个文件夹的分布，了解哪些内容可以安全地重新生成，并找出最大的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掃描你的個人專屬檔案夾，依大小查看每個檔案夾的分佈，了解哪些內容可以安全地重新產生，並找出最大的檔案。"
          }
        }
      }
    },
