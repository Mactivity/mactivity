        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Docker envía al contenedor su señal de detención y lo termina a la fuerza si sigue en ejecución tras %lld segundo."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Docker envía al contenedor su señal de detención y lo termina a la fuerza si sigue en ejecución tras %lld segundos."
                }
              }
            }
