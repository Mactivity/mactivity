    },
    "The address is on loan until then. Your Mac renews it well before, on its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Adresse ist bis dahin geliehen. Dein Mac verlängert sie rechtzeitig vorher von selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección se presta hasta entonces. Tu Mac la renueva mucho antes, por sí solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’adresse est prêtée jusque-là. Votre Mac la renouvelle bien avant, tout seul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’indirizzo è in prestito fino ad allora. Il Mac lo rinnova per tempo, da solo."
          }
