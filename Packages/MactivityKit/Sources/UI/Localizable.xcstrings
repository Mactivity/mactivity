    "Used since %@. Low Data Mode is on, so macOS holds back background downloads." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbraucht seit %@. Der Modus für geringe Datennutzung ist aktiviert, daher hält macOS Downloads im Hintergrund zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En uso desde las %@. El modo de datos reducidos está activado, así que macOS frena las descargas en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Données utilisées depuis %@. Le mode données réduites est activé, donc macOS limite les téléchargements en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In uso dalle %@. Modalità dati ridotti è attiva, quindi macOS limita i download in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@以降の使用量です。省データモードがオンのため、macOSはバックグラウンドのダウンロードを控えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이후 사용량입니다. 저데이터 모드가 켜져 있어 macOS가 백그라운드 다운로드를 보류합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbruikt sinds %@. De modus voor weinig data staat aan, dus macOS houdt downloads op de achtergrond tegen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usados desde %@. O Modo Dados Reduzidos está ativado, então o macOS adia os downloads em segundo plano."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 以来的用量。低数据模式已开启，macOS 会暂缓后台下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 以來的用量。低數據模式已開啟，macOS 會暫緩背景下載。"
          }
        }
      }
    },
    "Used since %@. Mactivity alerts you when an app uses a lot; Low Data Mode, in Wi-Fi settings, holds back background downloads." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbraucht seit %@. Mactivity warnt dich, wenn eine App viel verbraucht; der Modus für geringe Datennutzung in den WLAN-Einstellungen hält Downloads im Hintergrund zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En uso desde las %@. Mactivity te avisa cuando una app usa muchos datos; el modo de datos reducidos, en los ajustes de Wi-Fi, frena las descargas en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Données utilisées depuis %@. Mactivity vous alerte quand une app en utilise beaucoup ; le mode données réduites, dans les réglages Wi-Fi, limite les téléchargements en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In uso dalle %@. Mactivity ti avvisa quando un'app usa molti dati; Modalità dati ridotti, nelle impostazioni Wi-Fi, limita i download in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@以降の使用量です。アプリが大量に使用するとMactivityが通知します。Wi-Fi設定の省データモードで、バックグラウンドのダウンロードを控えることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이후 사용량입니다. 앱이 데이터를 많이 사용하면 Mactivity가 알려 줍니다. Wi-Fi 설정의 저데이터 모드를 사용하면 백그라운드 다운로드가 보류됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbruikt sinds %@. Mactivity waarschuwt je als een app veel verbruikt; de modus voor weinig data, in de wifi-instellingen, houdt downloads op de achtergrond tegen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usados desde %@. O Mactivity avisa quando um app usa muito; o Modo Dados Reduzidos, nos ajustes de Wi-Fi, adia os downloads em segundo plano."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 以来的用量。App 大量使用流量时，Mactivity 会提醒你；无线局域网设置中的“低数据模式”可以暂缓后台下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 以來的用量。App 大量使用數據時，Mactivity 會提醒你；Wi-Fi 設定中的「低數據模式」可以暫緩背景下載。"
          }
        }
      }
    },
    "Used when this Mac shares its connection with other devices over Wi-Fi." : {
