    "The macOS firewall is off: any of these accept connections from your network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die macOS-Firewall ist aus: Jeder dieser Ports nimmt Verbindungen aus deinem Netzwerk an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El firewall de macOS está desactivado: cualquiera de estos puertos acepta conexiones de tu red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
