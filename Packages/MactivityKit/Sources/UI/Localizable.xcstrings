    "Moved %@ of attachments to the Trash. Empty the Trash to free the space." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ an Anhängen in den Papierkorb gelegt. Leere den Papierkorb, um den Platz freizugeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han trasladado %@ de adjuntos a la papelera. Vacía la papelera para liberar el espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de pièces jointes placés dans la corbeille. Videz la corbeille pour libérer l’espace."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
