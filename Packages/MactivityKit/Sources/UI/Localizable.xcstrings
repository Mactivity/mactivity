          "stringUnit" : {
            "state" : "translated",
            "value" : "O contêiner para e depois inicia novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容器会先停止，然后再次启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容器會先停止，然後再次啟動。"
          }
        }
      }
    },
    "The container stops, then starts again. Connections to %@ drop while it restarts." : {
      "comment" : "Restart confirmation; the argument is a port phrase such as “port 5432”",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Container wird gestoppt und wieder gestartet. Verbindungen zu %@ brechen während des Neustarts ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenedor se detiene y vuelve a iniciarse. Las conexiones con %@ se cortan mientras se reinicia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
