    "Encrypts the startup disk, so no one can read it without your password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschlüsselt das Startvolume, damit niemand es ohne dein Passwort lesen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encripta el disco de arranque para que nadie pueda leerlo sin tu contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiffre le disque de démarrage pour que personne ne puisse le lire sans votre mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crittografa il disco di avvio, così nessuno può leggerlo senza la tua password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動ディスクを暗号化して、パスワードがなければ誰も読み取れないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시동 디스크를 암호화하여 암호 없이는 아무도 읽을 수 없게 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versleutelt de opstartschijf, zodat niemand hem kan lezen zonder je wachtwoord."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criptografa o disco de inicialização, para que ninguém possa lê-lo sem sua senha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加密启动磁盘，没有你的密码，任何人都无法读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加密啟動磁碟，沒有你的密碼，任何人都無法讀取。"
          }
        }
      }
    },
    "End of life only. Settings → Privacy can also check Homebrew's packages for known vulnerabilities." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur das Supportende wird geprüft. Unter „Einstellungen“ → „Datenschutz“ lassen sich Homebrew-Pakete auch auf bekannte Sicherheitslücken prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo fin del soporte. Ajustes → Privacidad también puede buscar vulnerabilidades conocidas en los paquetes de Homebrew."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fin de prise en charge uniquement. Réglages → Confidentialité peut aussi rechercher les vulnérabilités connues dans les paquets Homebrew."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo fine del supporto. Impostazioni → Privacy può anche cercare vulnerabilità note nei pacchetti Homebrew."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サポート終了のみを確認しています。「設定」→「プライバシー」で、Homebrewのパッケージの既知の脆弱性も確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원 종료 여부만 확인합니다. 설정 → 개인정보 보호에서 Homebrew 패키지의 알려진 취약점도 확인하도록 설정할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen einde van ondersteuning. Instellingen → Privacy kan Homebrew-pakketten ook op bekende kwetsbaarheden controleren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente fim do suporte. Ajustes → Privacidade também pode verificar vulnerabilidades conhecidas nos pacotes do Homebrew."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅检查是否已停止支持。“设置”→“隐私”还可以检查 Homebrew 软件包的已知漏洞。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅檢查是否已停止支援。「設定」→「隱私權」還可以檢查 Homebrew 套件的已知漏洞。"
          }
        }
      }
    },
