    "Memory written to disk because RAM was full. A lot of it slows your Mac down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speicher, der auf die Festplatte geschrieben wurde, weil der Arbeitsspeicher voll war. Viel davon verlangsamt deinen Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoria escrita en el disco porque la RAM estaba llena. Si hay mucha, tu Mac va más lento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mémoire écrite sur le disque parce que la RAM était pleine. Si elle est importante, votre Mac ralentit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoria scritta sul disco perché la RAM era piena. Se è molta, il Mac rallenta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAMがいっぱいになったためディスクに書き出されたメモリです。多いとMacの動作が遅くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAM이 가득 차서 디스크에 기록된 메모리입니다. 많으면 Mac이 느려집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geheugen dat naar schijf is geschreven omdat het RAM vol was. Veel ervan maakt je Mac trager."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memória gravada no disco porque a RAM estava cheia. Muito dela deixa o seu Mac mais lento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因 RAM 已满而写入磁盘的内存。过多会让你的 Mac 变慢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因 RAM 已滿而寫入磁碟的記憶體。過多會讓你的 Mac 變慢。"
          }
        }
      }
    },
