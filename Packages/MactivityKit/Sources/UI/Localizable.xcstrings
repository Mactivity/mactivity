    "The recording couldn't be written in full. Is the disk full?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufzeichnung konnte nicht vollständig geschrieben werden. Ist das Volume voll?"
          }
