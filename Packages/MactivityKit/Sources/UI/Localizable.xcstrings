          }
        }
      }
    },
    "Mactivity can't read notifications from macOS's log right now, so new ones aren't being counted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity kann Mitteilungen gerade nicht aus dem macOS-Protokoll lesen, neue werden also nicht gezählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity no puede leer las notificaciones del registro de macOS en este momento, así que las nuevas no se están contando."
