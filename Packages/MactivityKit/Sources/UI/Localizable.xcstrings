          }
        }
      }
    },
    "Safari's and system services' traffic counts in the totals, not per app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenverkehr von Safari und Systemdiensten zählt zu den Summen, nicht pro App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
