    "That device isn't connected. %@ plays on the system default until it's back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät ist nicht verbunden. %@ nutzt die Standardausgabe des Systems, bis es wieder da ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese dispositivo no está conectado. %@ suena en la salida predeterminada del sistema hasta que vuelva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil n’est pas connecté. %@ utilise la sortie par défaut du système jusqu’à son retour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel dispositivo non è collegato. %@ suona sull'uscita predefinita di sistema finché non torna disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのデバイスは接続されていません。再接続されるまで、%@はシステムのデフォルト出力で再生されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 기기가 연결되어 있지 않습니다. 다시 연결될 때까지 %@은(는) 시스템 기본값으로 재생됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat apparaat is niet verbonden. %@ speelt af via de systeemstandaard tot het terug is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse dispositivo não está conectado. %@ toca na saída padrão do sistema até ele voltar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该设备未连接。在其重新连接之前，%@ 将通过系统默认输出播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該裝置未連接。在其重新連接之前，%@ 會透過系統預設輸出播放。"
          }
        }
      }
    },
