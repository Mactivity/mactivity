          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het adres is tot dan in bruikleen. Je Mac verlengt het ruim van tevoren, vanzelf."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O endereço é emprestado até lá. O Mac o renova bem antes, sozinho."
