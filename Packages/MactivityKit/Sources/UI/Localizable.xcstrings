        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS heeft dit zelf geschreven voor Schermtijd, of voor een app die de bediening van Schermtijd gebruikt. Geen beheersysteem heeft het daar gezet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
