    },
    "If you move Mactivity, run it again. To remove it: `sudo rm %@`" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du Mactivity bewegst, führe den Befehl erneut aus. Zum Entfernen: `sudo rm %@`"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si mueves Mactivity, vuelve a ejecutarlo. Para eliminarlo: `sudo rm %@`"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous déplacez Mactivity, relancez la commande. Pour supprimer l’outil : `sudo rm %@`"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
