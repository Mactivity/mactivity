    "NFS activity shows after a second reading, about 10 seconds. macOS doesn't count it per share." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NFS-Aktivität erscheint nach einer zweiten Messung, etwa 10 Sekunden. macOS zählt sie nicht pro Freigabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actividad NFS aparece tras una segunda lectura, unos 10 segundos. macOS no la cuenta por recurso compartido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’activité NFS s’affiche après un deuxième relevé, environ 10 secondes. macOS ne la compte pas par partage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'attività NFS compare dopo una seconda lettura, circa 10 secondi. macOS non la conta per singola condivisione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NFSのアクティビティは2回目の読み取り（約10秒後）で表示されます。macOSは共有ごとには集計しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NFS 활동은 두 번째 측정 후(약 10초) 표시됩니다. macOS는 공유별로 집계하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NFS-activiteit verschijnt na een tweede meting, ongeveer 10 seconden. macOS telt die niet per share."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A atividade NFS aparece após uma segunda leitura, cerca de 10 segundos. O macOS não a conta por compartilhamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NFS 活动会在第二次读数后显示，约需 10 秒。macOS 不按共享分别统计。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NFS 活動會在第二次讀數後顯示，約需 10 秒。macOS 不會依共享分別統計。"
          }
        }
      }
    },
    "NFS shares together, calls a second: reads %@, writes %@. macOS doesn't count them per share." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NFS-Freigaben zusammen, Aufrufe pro Sekunde: Lesen %1$@, Schreiben %2$@. macOS zählt sie nicht pro Freigabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "NFS shares together, calls a second: reads %1$@, writes %2$@. macOS doesn't count them per share."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recursos NFS en conjunto, llamadas por segundo: lecturas %1$@, escrituras %2$@. macOS no las cuenta por recurso compartido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partages NFS ensemble, appels par seconde : lectures %1$@, écritures %2$@. macOS ne les compte pas par partage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condivisioni NFS insieme, chiamate al secondo: letture %1$@, scritture %2$@. macOS non le conta per singola condivisione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NFS共有の合計、1秒あたりの呼び出し：読み取り%1$@、書き込み%2$@。macOSは共有ごとには集計しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NFS 공유 합계, 초당 호출: 읽기 %1$@, 쓰기 %2$@. macOS는 공유별로 집계하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NFS-shares samen, aanroepen per seconde: lezen %1$@, schrijven %2$@. macOS telt ze niet per share."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhamentos NFS juntos, chamadas por segundo: leituras %1$@, gravações %2$@. O macOS não as conta por compartilhamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有 NFS 共享合计，每秒调用数：读取 %1$@，写入 %2$@。macOS 不按共享分别统计。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有 NFS 共享合計，每秒呼叫數：讀取 %1$@，寫入 %2$@。macOS 不會依共享分別統計。"
          }
        }
      }
    },
