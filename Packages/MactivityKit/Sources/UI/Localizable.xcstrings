          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내부 파일: %1$@. 그중 일부: %2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestanden erin: %1$@. Waaronder: %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
