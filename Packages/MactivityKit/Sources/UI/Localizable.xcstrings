    },
    "If it felt slow a moment ago, the CPU and Memory tabs show the last hour." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn es eben noch langsam wirkte, zeigen die Tabs „CPU“ und „Speicher“ die letzte Stunde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si iba lento hace un momento, las pestañas CPU y Memoria muestran la última hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’il semblait lent il y a un instant, les onglets Processeur et Mémoire montrent la dernière heure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se era lento poco fa, le schede CPU e Memoria mostrano l'ultima ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少し前に遅く感じた場合は、“CPU”タブと“メモリ”タブで過去1時間を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조금 전에 느렸다면 CPU 및 메모리 탭에서 지난 1시간을 확인할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voelde het net traag, dan tonen de tabbladen CPU en Geheugen het afgelopen uur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pareceu lento há pouco, as abas CPU e Memória mostram a última hora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果刚才感觉很慢，“CPU”和“内存”标签页会显示过去一小时的情况。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果剛才感覺很慢，「CPU」和「記憶體」標籤頁會顯示過去一小時的情況。"
          }
        }
      }
    },
    "If you don't see Mactivity there, allow it in System Settings → Menu Bar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Mactivity dort nicht angezeigt wird, erlaube es in „Systemeinstellungen“ → „Menüleiste“."
          }
        },
        "es" : {
          "stringUnit" : {
