    "From an app starting to it being ready, the median of the last two weeks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom Start einer App bis sie bereit ist, der Median der letzten zwei Wochen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde que una app arranca hasta que está lista, la mediana de las dos últimas semanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lancement d’une app au moment où elle est prête, la médiane des deux dernières semaines."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dall’avvio di un’app a quando è pronta, la mediana delle ultime due settimane."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
