    },
    "Everything inside an app bundle counts as Apps, inside a Library as System & library, and inside node_modules, DerivedData, and other build folders as Developer. The rest goes by file type." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles in einem App-Bundle zählt als „Apps“, in einer Library als „System & Library“ und in node_modules, DerivedData und anderen Build-Ordnern als „Entwickler“. Der Rest wird nach Dateityp eingeordnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que hay dentro de un paquete de app cuenta como Apps; dentro de una carpeta Library, como Sistema y biblioteca; y dentro de node_modules, DerivedData y otras carpetas de compilación, como Desarrollo. El resto se clasifica por tipo de archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui se trouve dans un paquet d’app compte comme Apps, dans une Bibliothèque comme Système et bibliothèque, et dans node_modules, DerivedData et d’autres dossiers de compilation comme Développeur. Le reste est classé par type de fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che si trova in un bundle di app conta come App, in una cartella Library come Sistema e libreria, e in node_modules, DerivedData e altre cartelle di build come Sviluppo. Il resto viene classificato per tipo di file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリバンドル内のものはすべて“アプリ”、ライブラリ内は“システムとライブラリ”、node_modules、DerivedData、その他のビルドフォルダ内は“デベロッパ”に分類されます。それ以外はファイルの種類で分類されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 번들 내부의 모든 항목은 앱, 라이브러리 내부는 시스템 및 라이브러리, node_modules, DerivedData 및 기타 빌드 폴더 내부는 개발자로 분류됩니다. 나머지는 파일 유형에 따라 분류됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles in een app-bundel telt als Apps, in een Bibliotheek-map als Systeem en bibliotheek, en in node_modules, DerivedData en andere buildmappen als Ontwikkelaar. De rest gaat op bestandstype."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo dentro de um pacote de app conta como Apps; dentro de uma Biblioteca, como Sistema e bibliotecas; e dentro de node_modules, DerivedData e outras pastas de compilação, como Desenvolvedor. O resto é classificado por tipo de arquivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 包内的所有内容都计为“App”，资源库内的计为“系统与资源库”，node_modules、DerivedData 及其他构建文件夹内的计为“开发者”。其余按文件类型分类。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 套件內的所有內容都算作「App」，資料庫內的算作「系統與資料庫」，node_modules、DerivedData 及其他建置檔案夾內的算作「開發者」。其餘依檔案類型分類。"
          }
        }
      }
    },
