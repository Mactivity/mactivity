{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "shouldTranslate" : false
    },
    "%@\nOlder copy: the one in %@, version %@, stays." : {
      "comment" : "Old app versions, a row: its path, then why it's listed; the folder and version of the copy that stays",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\nÄltere Kopie: Die in %2$@, Version %3$@, bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@\nOlder copy: the one in %2$@, version %3$@, stays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\nCopia más antigua: la de %2$@, versión %3$@, se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\nCopie plus ancienne : celle de %2$@, version %3$@, reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\nCopia più vecchia: resta quella in %2$@, versione %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n古いコピー：%2$@にあるバージョン%3$@が残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n오래된 복사본: %2$@에 있는 버전 %3$@이(가) 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\nOudere kopie: die in %2$@, versie %3$@, blijft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\nCópia mais antiga: fica a que está em %2$@, versão %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n较旧的副本：将保留 %2$@ 中的版本 %3$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n較舊的副本：會保留 %2$@ 中的版本 %3$@。"
          }
        }
      }
    },
    "%@\nSecond copy of the same version as the one in %@, which stays." : {
      "comment" : "Old app versions, a row: its path, then why it's listed; the folder of the copy that stays",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\nZweite Kopie derselben Version wie die in %2$@, die bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@\nSecond copy of the same version as the one in %2$@, which stays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\nSegunda copia de la misma versión que la de %2$@, que se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\nDeuxième copie de la même version que celle de %2$@, qui reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\nSeconda copia della stessa versione di quella in %2$@, che resta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n同じバージョンの2つ目のコピー：%2$@にあるものが残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n같은 버전의 두 번째 복사본: %2$@에 있는 항목이 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\nTweede kopie van dezelfde versie als die in %2$@, die blijft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\nSegunda cópia da mesma versão da que está em %2$@, que fica."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n与 %2$@ 中的版本相同的第二份副本，后者将保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\n與 %2$@ 中的版本相同的第二份副本，後者會保留。"
          }
        }
      }
    },
