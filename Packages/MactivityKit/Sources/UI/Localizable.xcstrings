    "Mactivity needs Full Disk Access to read %@'s extensions." : {
      "comment" : "Security page: browsers whose folders macOS protects, e.g. Google Chrome and Microsoft Edge",
      "localizations" : {
        "de" : {
          "stringUnit" : {
