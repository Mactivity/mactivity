    "Never connects to a database or reads what's in it: only process figures, and file names, sizes and dates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindet sich nie mit einer Datenbank und liest nie ihren Inhalt: nur Prozesswerte sowie Dateinamen, -größen und -daten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca se conecta a una base de datos ni lee su contenido: solo los valores de los procesos y los nombres, tamaños y fechas de los archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne se connecte jamais à une base de données et n’en lit jamais le contenu : seulement les valeurs des processus, et les noms, tailles et dates des fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non si connette mai a un database né ne legge il contenuto: solo valori del processo, e nomi, dimensioni e date dei file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データベースに接続したり中身を読み取ったりすることは一切ありません。使用するのはプロセスの数値と、ファイルの名前、サイズ、日付だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터베이스에 연결하거나 내용을 읽는 일은 절대 없습니다. 프로세스 수치와 파일 이름, 크기, 날짜만 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt nooit verbinding met een database en leest niet wat erin staat: alleen proceswaarden, en bestandsnamen, -groottes en -datums."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca se conecta a um banco de dados nem lê o conteúdo: só valores do processo, e nomes, tamanhos e datas de arquivos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绝不连接数据库或读取其内容：只使用进程数值，以及文件名、大小和日期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絕不連線到資料庫或讀取其內容：只使用程序數值，以及檔案名稱、大小和日期。"
          }
        }
      }
    },
