    "Recorded since %@. macOS's log keeps these about a day, so some can be missing if Mactivity was closed for longer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgezeichnet seit %@. Das macOS-Protokoll bewahrt diese etwa einen Tag auf, daher können einige fehlen, wenn Mactivity länger geschlossen war."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registradas desde %@. El registro de macOS las guarda alrededor de un día, así que puede faltar alguna si Mactivity estuvo cerrado más tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrées depuis %@. Le journal de macOS les conserve environ un jour : certaines peuvent manquer si Mactivity est resté fermé plus longtemps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrate dal %@. Il log di macOS le conserva circa un giorno, quindi alcune possono mancare se Mactivity è rimasto chiuso più a lungo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@以降の記録です。macOSのログはこれらを約1日保持するため、Mactivityをそれより長く閉じていた場合は一部が欠けることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@부터 기록되었습니다. macOS 로그는 이 항목을 약 하루 동안 보관하므로, Mactivity를 그보다 오래 닫아 두었다면 일부가 누락될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastgelegd sinds %@. Het macOS-logboek bewaart deze ongeveer een dag, dus er kunnen er ontbreken als Mactivity langer gesloten was."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registradas desde %@. O log do macOS as mantém por cerca de um dia, então algumas podem faltar se o Mactivity ficou fechado por mais tempo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自 %@ 起记录。macOS 日志约保留一天，因此如果 Mactivity 关闭超过这个时间，可能会缺少部分记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自 %@ 起記錄。macOS 記錄檔約保留一天，因此如果 Mactivity 關閉超過這個時間，可能會缺少部分記錄。"
          }
        }
      }
    },
