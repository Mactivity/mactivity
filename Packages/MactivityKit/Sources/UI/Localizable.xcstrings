    },
    "Can control another app: open its documents, read them and act in it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kann eine andere App steuern: ihre Dokumente öffnen, lesen und darin Aktionen ausführen."
          }
        },
        "es" : {
          "stringUnit" : {
