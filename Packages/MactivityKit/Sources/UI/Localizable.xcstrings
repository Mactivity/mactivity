    "Nothing to change: it doesn't sit at full for long, charge while hot, or run low often." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts zu ändern: Sie bleibt nicht lange voll geladen am Strom, lädt nicht bei Hitze und ist selten fast leer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada que cambiar: no pasa mucho tiempo con la carga completa, no se carga con calor y rara vez se queda con poca batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à changer : elle ne reste pas longtemps pleine, ne se recharge pas quand le Mac chauffe et se vide rarement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente da cambiare: non resta a lungo carica al massimo, non si ricarica quando è calda e raramente si scarica quasi del tutto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更の必要はありません。フル充電のまま長時間置かれることも、高温時の充電や残量低下が頻繁に起きることもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바꿀 것이 없습니다. 완전 충전 상태로 오래 있거나, 뜨거울 때 충전하거나, 자주 방전에 가까워지지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niets te veranderen: hij staat niet lang op vol, laadt niet op als hij heet is en raakt niet vaak bijna leeg."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada a mudar: o Mac não fica muito tempo com carga completa, não carrega quando está quente e raramente fica com pouca bateria."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需改变：它不会长时间保持充满、不会在高温时充电，也不常电量过低。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無需改變：它不會長時間保持充飽、不會在高溫時充電，也不常電量過低。"
          }
        }
      }
    },
