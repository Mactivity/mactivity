    "Launch times appear once apps have opened a few times while Mactivity runs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startzeiten erscheinen, sobald Apps ein paar Mal geöffnet wurden, während Mactivity läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tiempos aparecen cuando las apps se han abierto varias veces con Mactivity en marcha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les temps d’ouverture apparaissent une fois que des apps se sont ouvertes quelques fois pendant que Mactivity tourne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tempi compaiono quando le app sono state aperte alcune volte mentre Mactivity è in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivityの実行中にアプリが何回か開かれると、起動時間が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity 실행 중 앱이 몇 번 열리면 실행 시간이 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opstarttijden verschijnen zodra apps een paar keer zijn geopend terwijl Mactivity draait."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os tempos aparecem depois que apps forem abertos algumas vezes com o Mactivity rodando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity 运行期间 App 打开几次后，就会显示启动时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity 執行期間 App 開啟幾次後，就會顯示啟動時間。"
          }
        }
      }
    },
