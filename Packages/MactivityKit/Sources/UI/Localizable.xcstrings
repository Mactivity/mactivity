        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments placés dans la corbeille depuis l’analyse n’apparaissent pas encore ici. Relancez l’analyse pour actualiser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
