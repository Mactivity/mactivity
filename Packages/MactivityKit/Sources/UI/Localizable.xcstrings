            "value" : "Homebrewで%@をアップグレードできませんでした。ターミナルでbrew upgradeを実行すると理由を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew에서 %@을(를) 업그레이드하지 못했습니다. 이유를 보려면 터미널에서 brew upgrade를 실행하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew kon %@ niet upgraden. Voer brew upgrade uit in Terminal om te zien waarom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Homebrew não conseguiu atualizar %@. Execute brew upgrade no Terminal para ver o motivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew 无法升级 %@。在“终端”中运行 brew upgrade 以查看原因。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew 無法升級 %@。在「終端機」中執行 brew upgrade 以查看原因。"
          }
        }
      }
    },
