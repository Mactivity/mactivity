        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우의 개요에 표시되는 행입니다. 각 수치에 표시할 내용은 일반 → 수치에서 설정합니다."
          }
        },
        "nl" : {
