    "Timed from the compilers Mactivity sees, by project: Xcode and Swift, Rust, Go, C and C++." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemessen an den Compilern, die Mactivity sieht, nach Projekt: Xcode und Swift, Rust, Go, C und C++."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medidos a partir de los compiladores que ve Mactivity, por proyecto: Xcode y Swift, Rust, Go, C y C++."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesurées d’après les compilateurs que Mactivity voit, par projet : Xcode et Swift, Rust, Go, C et C++."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misurati dai compilatori che Mactivity vede, per progetto: Xcode e Swift, Rust, Go, C e C++."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivityが検出したコンパイラからプロジェクトごとに計測：XcodeとSwift、Rust、Go、CとC++。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity가 감지한 컴파일러로 프로젝트별로 측정: Xcode 및 Swift, Rust, Go, C 및 C++."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemeten aan de compilers die Mactivity ziet, per project: Xcode en Swift, Rust, Go, C en C++."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medidos pelos compiladores que o Mactivity vê, por projeto: Xcode e Swift, Rust, Go, C e C++."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
