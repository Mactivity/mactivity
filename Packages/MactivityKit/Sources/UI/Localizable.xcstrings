    "What Finder's iCloud Drive shows. Remove Download, as in Finder: the file stays in iCloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was iCloud Drive im Finder zeigt. „Download entfernen“ wie im Finder: Die Datei bleibt in iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que muestra iCloud Drive en el Finder. Eliminar descarga, como en el Finder: el archivo sigue en iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qu’affiche iCloud Drive dans le Finder. Supprimer le téléchargement, comme dans le Finder : le fichier reste dans iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che mostra iCloud Drive nel Finder. Rimuovi download, come nel Finder: il file resta su iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FinderのiCloud Driveに表示されるものです。Finderと同じ「ダウンロードを削除」で、ファイルはiCloudに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder의 iCloud Drive에 표시되는 항목입니다. Finder와 같은 다운로드 제거: 파일은 iCloud에 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat iCloud Drive in de Finder toont. Verwijder download, net als in de Finder: het bestand blijft in iCloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que o iCloud Drive mostra no Finder. Remover Download, como no Finder: o arquivo continua no iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“访达”中“iCloud 云盘”显示的内容。与“访达”相同的“移除下载项”：文件仍保留在 iCloud 中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Finder」中「iCloud 雲碟」顯示的內容。與「Finder」相同的「移除下載項目」：檔案仍保留在 iCloud 中。"
          }
