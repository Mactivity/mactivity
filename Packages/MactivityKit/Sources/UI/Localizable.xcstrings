    "Items moved to the Trash since the scan aren't reflected here yet. Rescan to update." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit dem Scan in den Papierkorb gelegte Objekte sind hier noch nicht berücksichtigt. Scanne erneut, um zu aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos trasladados a la papelera desde el análisis aún no se reflejan aquí. Vuelve a analizar para actualizar."
