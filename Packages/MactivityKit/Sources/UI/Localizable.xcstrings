          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache e copie di iCloud che macOS rimuove da solo quando ha bisogno di spazio. Fai clic per i dettagli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSが必要に応じて自動的に削除するキャッシュやiCloudのコピーです。クリックすると詳細を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
