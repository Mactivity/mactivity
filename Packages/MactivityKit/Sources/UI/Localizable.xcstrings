        }
      }
    },
    "Moved %@ and its files to the Trash. You can put them back from there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ und die zugehörigen Dateien wurden in den Papierkorb gelegt. Du kannst sie von dort zurücklegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han trasladado %@ y sus archivos a la papelera. Puedes recuperarlos desde allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ et ses fichiers ont été placés dans la corbeille. Vous pouvez les remettre en place depuis celle-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e i relativi file sono stati spostati nel Cestino. Puoi recuperarli da lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@とそのファイルをゴミ箱に入れました。ゴミ箱から戻すことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 및 관련 파일을 휴지통으로 이동했습니다. 휴지통에서 되돌릴 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ en de bijbehorende bestanden zijn naar de prullenmand verplaatst. Je kunt ze daar terugzetten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e os arquivos dele foram movidos para o Lixo. Você pode recuperá-los de lá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已将 %@ 及其文件移到废纸篓。你可以从废纸篓中将其放回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已將 %@ 及其檔案丟到垃圾桶。你可以從垃圾桶將其放回。"
          }
        }
      }
    },
    "Moved %@ of attachments to the Trash. Couldn't move: %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
