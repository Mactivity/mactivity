        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac을 사용하는 방식을 바탕으로 새 Mac에서 고를 칩, 메모리, 저장 공간을 알려 줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De chip, het geheugen en de opslag voor een nieuwe Mac, op basis van hoe je deze gebruikt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O chip, a memória e o armazenamento a procurar em um Mac novo, com base em como você usa este."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据你使用这台 Mac 的方式，给出新 Mac 应选的芯片、内存和存储容量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據你使用這台 Mac 的方式，提供新 Mac 應選的晶片、記憶體與儲存空間。"
          }
        }
      }
    },
    "The container stops, then starts again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Container wird gestoppt und wieder gestartet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenedor se detiene y vuelve a iniciarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le conteneur s’arrête, puis redémarre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il container si arresta e poi si riavvia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテナが停止してから、再び起動します。"
