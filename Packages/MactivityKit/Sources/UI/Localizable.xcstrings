    "What your Mac is doing, one line at a time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was dein Mac tut, Zeile für Zeile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que hace tu Mac, línea a línea."
          }
        },
        "fr" : {
