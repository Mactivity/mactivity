    "Recently used files kept in memory so they open faster. macOS frees it as soon as apps need it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kürzlich verwendete Dateien, die im Speicher bleiben, damit sie schneller öffnen. macOS gibt ihn frei, sobald Apps ihn brauchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos usados hace poco que se guardan en memoria para abrirse más rápido. macOS libera esa memoria en cuanto las apps la necesitan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichiers récemment utilisés gardés en mémoire pour s’ouvrir plus vite. macOS libère cette mémoire dès que les apps en ont besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File usati di recente tenuti in memoria per aprirsi più in fretta. macOS libera questa memoria appena le app ne hanno bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すばやく開けるようにメモリに保持している、最近使ったファイルです。アプリが必要とすると、macOSはすぐにこのメモリを解放します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 빨리 열 수 있도록 메모리에 보관한 최근 사용 파일입니다. 앱에 메모리가 필요하면 macOS가 바로 해제합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onlangs gebruikte bestanden die in het geheugen blijven zodat ze sneller openen. macOS geeft dit geheugen vrij zodra apps het nodig hebben."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos usados recentemente mantidos na memória para abrir mais rápido. O macOS libera essa memória assim que os apps precisam dela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为更快打开而保留在内存中的最近使用的文件。App 需要内存时，macOS 会立即释放它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為更快打開而保留在記憶體中的最近使用檔案。App 需要記憶體時，macOS 會立即釋放。"
          }
        }
      }
    },
