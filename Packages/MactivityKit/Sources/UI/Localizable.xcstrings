      }
    },
    "The chip, memory and storage to look for in a new Mac, from how you use this one." : {
      "comment" : "History: what the Your next Mac report says",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chip, Arbeitsspeicher und Speicherplatz für einen neuen Mac – ermittelt aus deiner Nutzung dieses Macs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El chip, la memoria y el almacenamiento que buscar en un Mac nuevo, según cómo usas este."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La puce, la mémoire et le stockage à viser pour un nouveau Mac, d’après votre usage de celui-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il chip, la memoria e l’archiviazione da cercare in un nuovo Mac, in base a come usi questo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac の使い方から、新しい Mac で選ぶべきチップ、メモリ、ストレージを提案します。"
