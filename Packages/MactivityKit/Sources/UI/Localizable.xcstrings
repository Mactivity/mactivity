    "macOS shows another user's open files only to the privileged helper." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS zeigt geöffnete Dateien anderer Benutzer nur dem privilegierten Hilfsprogramm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS solo muestra los archivos abiertos de otro usuario al auxiliar con privilegios."
          }
        },
        "fr" : {
          "stringUnit" : {
