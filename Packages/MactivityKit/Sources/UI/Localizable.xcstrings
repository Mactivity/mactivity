    },
    "How much charge the battery holds now, compared with when it was new." : {
      "comment" : "Help: battery maximum capacity",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viel Ladung die Batterie jetzt noch fasst, verglichen mit ihrem Neuzustand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánta carga admite ahora la batería, en comparación con cuando era nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La charge que la batterie peut contenir aujourd’hui, par rapport à quand elle était neuve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanta carica contiene ora la batteria, rispetto a quando era nuova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリーが現在蓄えられる充電量を、新品のときと比べた値です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배터리가 새것이었을 때와 비교해 지금 저장할 수 있는 충전량입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoeveel lading de batterij nu kan bevatten, vergeleken met toen hij nieuw was."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanta carga a bateria comporta agora, em comparação com quando era nova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电池现在能容纳的电量，与全新时相比。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電池現在能容納的電量，與全新時相比。"
          }
        }
      }
    },
    "How much is read from or written to disk each second, in bytes (B/s). 1 MB is 1,000 kB, as Finder counts." : {
      "comment" : "Help: disk read and write rates",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viel pro Sekunde von der Festplatte gelesen oder darauf geschrieben wird, in Byte (B/s). 1 MB sind 1.000 kB, wie im Finder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto se lee del disco o se escribe en él cada segundo, en bytes (B/s). 1 MB son 1000 kB, como cuenta el Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantité lue ou écrite sur le disque chaque seconde, en octets (o/s). 1 Mo vaut 1 000 ko, comme dans le Finder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto viene letto dal disco o scritto su di esso ogni secondo, in byte (B/s). 1 MB equivale a 1.000 kB, come nel Finder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクから1秒あたりに読み込む量、または書き込む量で、単位はバイト（B/s）です。Finderと同じく、1 MBは1,000 kBです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크에서 초당 읽거나 쓰는 양으로, 단위는 바이트(B/s)입니다. Finder와 같은 방식으로 1MB는 1,000kB입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoeveel er per seconde van de schijf wordt gelezen of ernaar wordt geschreven, in bytes (B/s). 1 MB is 1.000 kB, zoals de Finder telt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto é lido ou gravado no disco por segundo, em bytes (B/s). 1 MB são 1.000 kB, como o Finder conta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每秒从磁盘读取或写入磁盘的数据量，以字节为单位（B/s）。与“访达”的计算方式相同，1 MB 为 1,000 kB。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每秒從磁碟讀取或寫入磁碟的資料量，以位元組為單位（B/s）。與「Finder」的計算方式相同，1 MB 為 1,000 kB。"
          }
        }
      }
    },
    "How the energy divided up between apps" : {
      "comment" : "Energy tab list on a Mac without a battery",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie sich die Energie auf die Apps verteilt hat"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo se repartió la energía entre las apps"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment l’énergie s’est répartie entre les apps"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come si è divisa l’energia tra le app"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ間でのエネルギーの配分"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 간 에너지 분배 내역"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe de energie over de apps verdeeld werd"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como a energia se dividiu entre os apps"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能耗在各 App 之间的分配情况"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能耗在各 App 之間的分配情況"
          }
        }
      }
    },
    "How warm the battery itself runs, from its own sensor. Heat is one of the things that wears a battery fastest, more so while it charges. In use is all the other time your Mac is awake: on battery, or plugged in and not charging." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie warm die Batterie selbst wird, laut ihrem eigenen Sensor. Hitze gehört zu dem, was eine Batterie am schnellsten abnutzt, beim Laden noch mehr. „Im Betrieb“ ist die übrige Zeit, in der dein Mac wach ist: im Batteriebetrieb oder angeschlossen, ohne zu laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La temperatura de la propia batería, según su propio sensor. El calor es una de las cosas que más rápido desgastan una batería, más aún mientras carga. “En uso” es el resto del tiempo que tu Mac está activo: con batería, o conectado y sin cargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La température de la batterie elle-même, d’après son propre capteur. La chaleur est l’une des choses qui usent le plus vite une batterie, plus encore pendant la charge. « Utilisation » désigne tout le reste du temps où votre Mac est éveillé : sur batterie, ou branché sans charger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto è calda la batteria stessa, secondo il suo sensore. Il calore è tra le cose che consumano di più una batteria, soprattutto durante la ricarica. In uso è tutto il resto del tempo in cui il Mac è attivo: a batteria, o collegato ma non in carica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリー自体のセンサーで測った温度です。熱はバッテリーを最も早く劣化させる要因の1つで、充電中は特に影響します。“使用中”は、Macがスリープしていないそれ以外のすべての時間です（バッテリー駆動中、または電源に接続中で充電していないとき）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배터리 자체 센서로 측정한 온도입니다. 열은 배터리를 가장 빠르게 마모시키는 요인 중 하나이며, 충전 중에는 더욱 그렇습니다. 사용 중은 Mac이 깨어 있는 나머지 모든 시간으로, 배터리를 사용 중이거나 전원에 연결되었지만 충전하지 않는 때입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe warm de batterij zelf wordt, volgens zijn eigen sensor. Warmte is een van de dingen die een batterij het snelst verslijten, vooral tijdens het opladen. ‘In gebruik’ is alle andere tijd dat je Mac wakker is: op batterij, of aangesloten zonder op te laden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O quão quente a própria bateria fica, pelo sensor dela. O calor é uma das coisas que mais desgastam a bateria, ainda mais durante a recarga. Em uso é todo o outro tempo em que o Mac está ativo: na bateria, ou conectado e sem carregar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电池自身的温度，来自其内置传感器。高温是电池损耗最快的原因之一，充电时尤甚。“使用中”是指 Mac 处于唤醒状态的其他所有时间：使用电池，或接通电源但未充电。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電池本身的溫度，來自其內建感測器。高溫是電池損耗最快的原因之一，充電時尤甚。「使用中」是指 Mac 處於喚醒狀態的其他所有時間：使用電池，或接上電源但未充電。"
          }
        }
      }
    },
