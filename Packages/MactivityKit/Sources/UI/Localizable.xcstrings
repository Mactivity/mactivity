        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece %@, escalada: nítida, con algo más de trabajo para la gráfica"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ressemble à %@, mis à l’échelle : net, au prix d’un peu plus de travail graphique"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simile a %@, ridimensionata: nitida, con un po’ di lavoro in più per la grafica"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@相当、スケーリング：鮮明ですが、グラフィックスの負荷が少し増えます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@처럼 보임, 조정됨: 선명하지만 그래픽 작업이 약간 늘어남"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
