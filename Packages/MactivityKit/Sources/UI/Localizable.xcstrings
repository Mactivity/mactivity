    "Caches and iCloud copies macOS removes on its own when it needs the space." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caches und iCloud-Kopien, die macOS selbst entfernt, wenn es den Platz braucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cachés y copias de iCloud que macOS elimina por sí solo cuando necesita espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caches et copies iCloud que macOS supprime de lui-même lorsqu’il a besoin d’espace."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache e copie di iCloud che macOS rimuove da solo quando ha bisogno di spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSが必要に応じて自動的に削除するキャッシュやiCloudのコピーです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 공간이 필요할 때 자동으로 제거하는 캐시 및 iCloud 사본입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caches en iCloud-kopieën die macOS zelf verwijdert wanneer het de ruimte nodig heeft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caches e cópias do iCloud que o macOS remove sozinho quando precisa do espaço."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 在需要空间时会自行移除的缓存和 iCloud 副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 在需要空間時會自行移除的快取和 iCloud 副本。"
          }
        }
      }
    },
    "Caches and iCloud copies macOS removes on its own when it needs the space. Click for details." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caches und iCloud-Kopien, die macOS selbst entfernt, wenn es den Platz braucht. Klicke für Details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cachés y copias de iCloud que macOS elimina por sí solo cuando necesita espacio. Haz clic para ver detalles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
