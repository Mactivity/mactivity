          }
        }
      }
    },
    "Its plist can't be read, so launchd can't load it." : {
      "comment" : "Startup flag",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die plist ist nicht lesbar, daher kann launchd sie nicht laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su plist no se puede leer, así que launchd no puede cargarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa plist est illisible, donc launchd ne peut pas la charger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
