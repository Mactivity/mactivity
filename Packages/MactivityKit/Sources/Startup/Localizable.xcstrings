        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응용 프로그램, 라이브러리 또는 Homebrew가 아닌 %@에서 실행됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het draait vanuit %@, niet vanuit Programma's, Bibliotheek of Homebrew."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele é executado em %@, não em Aplicativos, Biblioteca ou Homebrew."
          }
