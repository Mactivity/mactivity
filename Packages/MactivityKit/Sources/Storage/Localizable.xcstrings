        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakket-tarballs. npm downloadt ze opnieuw; offline installaties werken pas weer als de cache is aangevuld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
