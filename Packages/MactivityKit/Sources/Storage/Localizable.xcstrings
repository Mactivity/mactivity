    },
    "A Python environment. Recreate it and reinstall its packages, e.g. with `uv sync` or `pip install -r requirements.txt`." : {
      "comment" : "Space per project: what trashing a virtual environment costs. Keep text in backticks (commands) as is.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Python-Umgebung. Erstelle sie neu und installiere ihre Pakete erneut, z. B. mit `uv sync` oder `pip install -r requirements.txt`."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un entorno de Python. Vuelve a crearlo y reinstala sus paquetes, p. ej., con `uv sync` o `pip install -r requirements.txt`."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un environnement Python. Recréez-le et réinstallez ses paquets, par exemple avec `uv sync` ou `pip install -r requirements.txt`."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ambiente Python. Ricrealo e reinstalla i suoi pacchetti, ad es. con `uv sync` o `pip install -r requirements.txt`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python環境です。`uv sync`や`pip install -r requirements.txt`などで、環境を作り直してパッケージを再インストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python 환경입니다. 다시 만들고 패키지를 다시 설치해야 합니다(예: `uv sync` 또는 `pip install -r requirements.txt`)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een Python-omgeving. Maak die opnieuw aan en installeer de pakketten opnieuw, bijvoorbeeld met `uv sync` of `pip install -r requirements.txt`."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ambiente Python. Recrie-o e reinstale os pacotes, por exemplo com `uv sync` ou `pip install -r requirements.txt`."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python 环境。需要重新创建并重新安装其软件包，例如使用 `uv sync` 或 `pip install -r requirements.txt`。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Python 環境。需要重新建立並重新安裝其套件，例如使用 `uv sync` 或 `pip install -r requirements.txt`。"
          }
        }
      }
    },
