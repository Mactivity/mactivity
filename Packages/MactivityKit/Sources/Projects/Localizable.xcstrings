    "“%@” runs as %@. Its open files, sockets, and command line need the privileged helper." : {
      "comment" : "Process inspector. The arguments are a process name and a Unix user name, e.g. root.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ läuft als %2$@. Für geöffnete Dateien, Sockets und Befehlszeile wird das privilegierte Hilfsprogramm benötigt."
          }
        },
        "en" : {
          "stringUnit" : {
