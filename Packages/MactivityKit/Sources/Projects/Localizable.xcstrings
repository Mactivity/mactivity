          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” se ejecuta como %2$@. Sus archivos abiertos, sockets y línea de comandos requieren el auxiliar con privilegios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » s’exécute en tant que %2$@. Ses fichiers ouverts, sockets et ligne de commande nécessitent l’assistant privilégié."
