    "macOS didn't return “%@”'s files and sockets (error %d)." : {
      "comment" : "Process inspector. The arguments are a process name and a numeric POSIX error code.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat die Dateien und Sockets von „%1$@“ nicht geliefert (Fehler %2$d)."
          }
        },
        "en" : {
          "stringUnit" : {
