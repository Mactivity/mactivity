    "AirPlay Receiver. Turn it off in System Settings → General → AirDrop & Handoff." : {
      "comment" : "Open ports: what ControlCenter's listener is",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPlay-Empfänger. Schalte ihn unter „Systemeinstellungen“ → „Allgemein“ → „AirDrop & Handoff“ aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receptor AirPlay. Desactívalo en Ajustes del Sistema → General → AirDrop y Handoff."
