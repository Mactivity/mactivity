        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱의 오디오를 변경하려면 Mactivity에 권한이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
