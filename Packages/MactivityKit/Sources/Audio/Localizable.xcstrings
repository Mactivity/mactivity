{
  "sourceLanguage" : "en",
  "strings" : {
    "Mactivity needs permission to change this app's audio." : {
      "comment" : "Per-app volume error.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity benötigt eine Erlaubnis, um den Ton dieser App zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity necesita permiso para cambiar el audio de esta app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity a besoin d’une autorisation pour modifier l’audio de cette app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity necessita dell'autorizzazione per modificare l'audio di questa app."
