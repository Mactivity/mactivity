          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App gibt keinen Ton mehr wieder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa app ya no está reproduciendo audio."
          }
        },
        "fr" : {
