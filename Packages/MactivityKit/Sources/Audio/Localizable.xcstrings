        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity 需要權限才能更改此 App 的音訊。"
          }
        }
      }
    },
    "That app isn't playing audio any more." : {
      "comment" : "Per-app volume error.",
      "localizations" : {
