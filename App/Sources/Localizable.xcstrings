    },
    "To hold back key presses while you wipe the keyboard, Mactivity needs to be allowed in System Settings → Privacy & Security → Accessibility. The keyboard isn't locked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit Tastendrücke beim Abwischen ignoriert werden, muss Mactivity unter Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen erlaubt sein. Die Tastatur ist nicht gesperrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ignorar las pulsaciones mientras limpias el teclado, Mactivity debe estar permitido en Ajustes del Sistema → Privacidad y seguridad → Accesibilidad. El teclado no está bloqueado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour ignorer les frappes pendant que vous essuyez le clavier, Mactivity doit être autorisé dans Réglages Système → Confidentialité et sécurité → Accessibilité. Le clavier n’est pas verrouillé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ignorare i tasti mentre pulisci la tastiera, Mactivity deve essere consentito in Impostazioni di Sistema → Privacy e sicurezza → Accessibilità. La tastiera non è bloccata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードを拭く間キー入力を止めるには、システム設定 →「プライバシーとセキュリティ」→「アクセシビリティ」でMactivityを許可する必要があります。キーボードはロックされていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드를 닦는 동안 키 입력을 막으려면 시스템 설정 → 개인정보 보호 및 보안 → 손쉬운 사용에서 Mactivity를 허용해야 합니다. 키보드는 잠기지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om toetsaanslagen tegen te houden terwijl je het toetsenbord afveegt, moet Mactivity zijn toegestaan in Systeeminstellingen → Privacy en beveiliging → Toegankelijkheid. Het toetsenbord is niet vergrendeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ignorar as teclas enquanto você limpa o teclado, o Mactivity precisa estar permitido em Ajustes do Sistema → Privacidade e Segurança → Acessibilidade. O teclado não está bloqueado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要在擦拭键盘时屏蔽按键，需在“系统设置”→“隐私与安全性”→“辅助功能”中允许 Mactivity。键盘未被锁定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要在擦拭鍵盤時擋下按鍵，需在「系統設定」→「隱私權與安全性」→「輔助使用」中允許 Mactivity。鍵盤未被鎖定。"
          }
        }
      }
    },
