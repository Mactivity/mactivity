    "Apps doing far more than their usual day on this Mac, today." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps, die heute auf diesem Mac weit mehr tun als an einem üblichen Tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps que hoy hacen mucho más que en un día normal en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps qui en font bien plus qu’un jour habituel sur ce Mac, aujourd’hui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App che oggi fanno molto più del solito su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日、このMacでいつもの1日をはるかに上回る動きをしているアプリです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 이 Mac에서 평소 하루보다 훨씬 많이 작업하는 앱."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps die vandaag veel meer doen dan op hun gewone dag op deze Mac."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps fazendo muito mais do que no seu dia habitual neste Mac, hoje."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天在这台 Mac 上远超平常一天用量的 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天在這台 Mac 上遠超平常一天用量的 App。"
          }
        }
      }
    },
