    "NSNetworkVolumesUsageDescription" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity misst, wie viel Platz auf dem ausgewählten Netzwerkvolume belegt ist. Dateiinhalte werden weder gelesen noch geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mactivity measures how much space is used on the network volume you chose. It doesn't read or change file contents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity mide cuánto espacio se usa en el volumen de red que has elegido. No lee ni modifica el contenido de los archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity mesure l’espace utilisé sur le volume réseau que vous avez choisi. Il ne lit ni ne modifie le contenu des fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity misura quanto spazio è utilizzato sul volume di rete che hai scelto. Non legge né modifica il contenuto dei file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivityは選択したネットワークボリュームの使用容量を測定します。ファイルの内容の読み取りや変更は行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity는 선택한 네트워크 볼륨의 사용 공간을 측정합니다. 파일 내용을 읽거나 변경하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity meet hoeveel ruimte er in gebruik is op het netwerkvolume dat je hebt gekozen. Het leest of wijzigt de inhoud van bestanden niet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mactivity mede quanto espaço está sendo usado no volume de rede que você escolheu. Ele não lê nem altera o conteúdo dos arquivos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity 会计算你所选网络宗卷的已用空间，但不会读取或更改文件内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mactivity 會計算你所選網路卷宗的已使用空間，但不會讀取或更改檔案內容。"
          }
        }
      }
    },
