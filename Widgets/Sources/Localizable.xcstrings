    "Keep your Mac awake from the desktop. It still lets go on a low battery or when hot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte deinen Mac vom Schreibtisch aus wach. Bei schwacher Batterie oder Hitze gibt er trotzdem nach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén tu Mac despierto desde el escritorio. Aun así se detiene con poca batería o si se calienta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez votre Mac éveillé depuis le bureau. Il cède quand même si la batterie est faible ou s’il chauffe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni il Mac attivo dalla scrivania. Si ferma comunque con batteria scarica o se si scalda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デスクトップからMacをスリープさせないようにします。バッテリー残量が少ないときや高温時は解除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데스크탑에서 Mac을 깨어 있게 합니다. 배터리가 부족하거나 뜨거우면 해제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je Mac wakker vanaf het bureaublad. Bij een bijna lege batterij of hitte stopt het toch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o Mac acordado direto da Mesa. Ainda assim para com bateria fraca ou se esquentar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从桌面让 Mac 保持唤醒。电量低或过热时仍会自动停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從桌面讓 Mac 保持喚醒。電量低或過熱時仍會自動停止。"
          }
        }
      }
    },
    "Keeps your Mac from sleeping until you switch it off. It still lets go on a low battery or when hot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält deinen Mac wach, bis du es ausschaltest. Bei schwacher Batterie oder Hitze gibt er trotzdem nach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita que tu Mac entre en reposo hasta que lo desactives. Aun así se detiene con poca batería o si se calienta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empêche votre Mac de se mettre en veille jusqu’à ce que vous l’arrêtiez. Il cède quand même si la batterie est faible ou s’il chauffe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiene il Mac attivo finché non lo disattivi. Si ferma comunque con batteria scarica o se si scalda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにするまでMacをスリープさせません。バッテリー残量が少ないときや高温時は解除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끌 때까지 Mac이 잠자기 상태가 되지 않게 합니다. 배터리가 부족하거나 뜨거우면 해제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt je Mac wakker tot je het uitzet. Bij een bijna lege batterij of hitte stopt het toch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impede o Mac de repousar até você desligar. Ainda assim para com bateria fraca ou se esquentar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让 Mac 保持唤醒，直到你关闭。电量低或过热时仍会自动停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓 Mac 保持喚醒，直到你關閉。電量低或過熱時仍會自動停止。"
          }
        }
      }
    },
    "Locks every key while you wipe the keyboard. ⌃⌥K, Unlock or five minutes ends it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperrt alle Tasten, während du die Tastatur abwischst. ⌃⌥K, Entsperren oder fünf Minuten beenden es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea todas las teclas mientras limpias el teclado. ⌃⌥K, Desbloquear o cinco minutos lo terminan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouille toutes les touches pendant que vous essuyez le clavier. ⌃⌥K, Déverrouiller ou cinq minutes y mettent fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocca tutti i tasti mentre pulisci la tastiera. ⌃⌥K, Sblocca o cinque minuti lo terminano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードを拭く間、すべてのキーをロックします。⌃⌥K、ロック解除、または5分で終わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드를 닦는 동안 모든 키를 잠급니다. ⌃⌥K, 잠금 해제 또는 5분이 지나면 끝납니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrendelt alle toetsen terwijl je het toetsenbord afveegt. ⌃⌥K, Ontgrendel of vijf minuten beëindigt het."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueia todas as teclas enquanto você limpa o teclado. ⌃⌥K, Desbloquear ou cinco minutos encerram."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
