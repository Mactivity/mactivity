    "CPU, memory, and battery, with the apps using the most." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, Speicher und Batterie, mit den Apps, die am meisten nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, memoria y batería, con las apps que más consumen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Processeur, mémoire et batterie, avec les apps qui en utilisent le plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, memoria e batteria, con le app che ne usano di più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU、メモリ、バッテリーと、それらを最も多く使用しているアプリ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, 메모리, 배터리 및 이를 가장 많이 사용하는 앱."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, geheugen en batterij, met de apps die het meest gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, memória e bateria, com os apps que mais usam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU、内存和电池，以及占用最多的 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU、記憶體和電池，以及佔用最多的 App。"
          }
        }
      }
    },
